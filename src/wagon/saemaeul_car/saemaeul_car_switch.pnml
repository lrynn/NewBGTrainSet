// Cargo subtype
// Same as sw_DHC_subtype_text
switch(FEAT_TRAINS, SELF, sw_SAEMAEUL_CAR_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_LIVERY_KWANKWANG);
    2: return string(STR_REFIT_LIVERY_SAEMAEUL_1970_1983);
    3: return string(STR_REFIT_LIVERY_SAEMAEUL_EXECUTIVE_SILVER_BLUE);
    4: return string(STR_REFIT_LIVERY_SAEMAEUL_GREEN_YELLOW);
    5: return string(STR_REFIT_LIVERY_SAEMAEUL_EXECUTIVE_GREEN_YELLOW);
    6: return string(STR_REFIT_LIVERY_SAEMAEUL_RACKRAIL);
    7: return string(STR_REFIT_LIVERY_SAEMAEUL_EXECUTIVE_RACKRAIL);
    8: return string(STR_REFIT_LIVERY_SAEMAEUL_LIMIT);
    return string(STR_REFIT_LIVERY_SAEMAEUL_RACKRAIL);
}
switch(FEAT_TRAINS, SELF, sw_SAEMAEUL_CAR_wagon, cargo_subtype) {
    1: set_SAEMAEUL_CAR_wagon_KWANKWANG;
    2: set_SAEMAEUL_CAR_1;
    3: set_SAEMAEUL_CAR_executive_1;
    4: set_SAEMAEUL_CAR_2;
    5: set_SAEMAEUL_CAR_executive_2;
    6: set_SAEMAEUL_CAR_3;
    7: set_SAEMAEUL_CAR_executive_3;
    8: set_SAEMAEUL_CAR_limit;
    set_SAEMAEUL_CAR_3;
}

// Attach
switch(FEAT_TRAINS, SELF, sw_SAEMAEUL_CAR_attach, vehicle_type_id) {
    DHC:                  return CB_RESULT_ATTACH_ALLOW;
    // ko_train_ITX_SAEMAEUL: return CB_RESULT_ATTACH_ALLOW;
    // ko_train_K2x00:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_4400:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_7x00:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_7000:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_8000:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_8x00:        return CB_RESULT_ATTACH_ALLOW;
    ko_train_8500:        return CB_RESULT_ATTACH_ALLOW;
    // ko_train_PASSWG:       return CB_RESULT_ATTACH_ALLOW;
    ko_train_SAEMAEUL_CAR: return CB_RESULT_ATTACH_ALLOW;
    ko_train_CAFE_CAR:     return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}
switch(FEAT_TRAINS, SELF, sw_SAEMAEUL_CAR_attach_global, bool_no_vehicle_attachment_restrictions) {
    1: return CB_RESULT_ATTACH_ALLOW;
    sw_SAEMAEUL_CAR_attach;
}
