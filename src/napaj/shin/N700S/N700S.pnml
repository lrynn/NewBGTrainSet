/*------------------------------------------------------------------------------
    Shinkansen N700S Series
------------------------------------------------------------------------------*/

// Graphics
#include "N700S_graphic.pnml"

// Switch
#include "N700S_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/

item(FEAT_TRAINS, group_SHIN_N700S, 6171) {
    property {
        name:                           string(STR_group_N700S_NAME);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          1 kW;
        
        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }

    graphics {
        purchase:                       set_N700S_purchase;
    }
}

/*--------------------------------------------------------------------
열차 리스트
--------------------------------------------------------------------*/

item(FEAT_TRAINS, SHIN_N700S_6, 6177) {
    property {
        // Common properties
        name:                           string(STR_SHIN_N700S_6_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SHIN_N700S_6_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_SHIN_N700S;

        // Spec
        power:                          var_SHIN_N700S_6_POWER;
        weight:                         var_SHIN_N700S_6_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
    }
    graphics {
        default:                        sw_SHIN_N700S_6car;
        articulated_part:               sw_articulated_SHIN_N700S_6car;
        purchase:                       set_N700S_K_purchase;

        speed:                          var_SHIN_N700S_6_SPEED;
        cost_factor:                    var_SHIN_N700S_6_COST;
        running_cost_factor:            var_SHIN_N700S_6_RUNNINGCOST;
        cargo_capacity:                 var_SHIN_N700S_6_CAPACITY;
        purchase_cargo_capacity:        var_SHIN_N700S_6_CAPACITY;
        loading_speed:                  var_SHIN_N700S_6_LOADINGSPEED;

        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);
    }
}

item(FEAT_TRAINS, SHIN_N700S_16, 6179) {
    property {
        // Common properties
        name:                           string(STR_SHIN_N700S_16_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SHIN_N700S_16_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_SHIN_N700S;

        // Spec
        power:                          var_SHIN_N700S_16_POWER;
        weight:                         var_SHIN_N700S_16_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
    }
    graphics {
        default:                        sw_SHIN_N700S_16car;
        articulated_part:               sw_articulated_SHIN_N700S_16car;
        purchase:                       set_N700S_purchase;

        speed:                          var_SHIN_N700S_16_SPEED;
        cost_factor:                    var_SHIN_N700S_16_COST;
        running_cost_factor:            var_SHIN_N700S_16_RUNNINGCOST;
        cargo_capacity:                 var_SHIN_N700S_16_CAPACITY;
        purchase_cargo_capacity:        var_SHIN_N700S_16_CAPACITY;
        loading_speed:                  var_SHIN_N700S_16_LOADINGSPEED;

        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);
    }
}