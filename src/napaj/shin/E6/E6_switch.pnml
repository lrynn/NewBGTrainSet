/*--------------------------------------------------------------------
    Shinkansen E6 - Switches
--------------------------------------------------------------------*/

// Cargo Subtypes
// None

// 편성
switch (FEAT_TRAINS, SELF, sw_SHIN_E6, position_in_vehid_chain % 7) {
    1:set_SHIN_E6_panto_wagon_A;
    2:set_SHIN_E6_wagon;
    3:set_SHIN_E6_wagon;
    4:set_SHIN_E6_wagon;
    5:set_SHIN_E6_panto_wagon_B;
    6:set_SHIN_E6_engineT;
    set_SHIN_E6_engineH; //default
}

switch (FEAT_TRAINS, SELF, sw_SHIN_E6_r, position_in_vehid_chain % 7) {
    1:set_SHIN_E6_panto_wagon_B_r;
    2:set_SHIN_E6_wagon_r;
    3:set_SHIN_E6_wagon_r;
    4:set_SHIN_E6_wagon_r;
    5:set_SHIN_E6_panto_wagon_A_r;
    6:set_SHIN_E6_engineH_r;
    set_SHIN_E6_engineT_r; //default
    }

switch(FEAT_TRAINS, SELF, sw_SHIN_E6_flipped, vehicle_is_flipped){
    0: sw_SHIN_E6_r;
    sw_SHIN_E6;
}

switch(FEAT_TRAINS, PARENT, sw_SHIN_E6_reversed, vehicle_is_reversed){
    0: sw_SHIN_E6;
    sw_SHIN_E6_flipped;
}

switch (FEAT_TRAINS, SELF, sw_articulated_SHIN_E6, extra_callback_info1) {
    1..6: SHIN_E6;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}