/*------------------------------------------------------------------------------
  SHINKANSEN E6
------------------------------------------------------------------------------*/

// Graphics
#include "E6_graphic.pnml"

// Switches
#include "E6_switch.pnml"

item(FEAT_TRAINS, SHIN_E6, 6126) {
    property {
        // Common properties
        name:                           string(STR_SHIN_E6_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SHIN_E6_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;

        // Spec
        speed:                          var_SHIN_E6_SPEED;
        power:                          var_SHIN_E6_POWER;
        weight:                         var_SHIN_E6_WEIGHT;
        tractive_effort_coefficient:    0.4;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
    }
    graphics {
        default:                        sw_SHIN_E6_reversed;
        articulated_part:               sw_articulated_SHIN_E6;
        purchase:                       set_SHIN_E6_purchase;

        speed:                          var_SHIN_E6_SPEED;
        cost_factor:                    var_SHIN_E6_COST;
        running_cost_factor:            var_SHIN_E6_RUNNINGCOST;
        cargo_capacity:                 var_SHIN_E6_CAPACITY;
        purchase_cargo_capacity:        var_SHIN_E6_CAPACITY;
        loading_speed:                  var_SHIN_E6_LOADINGSPEED;

        can_attach_wagon:               sw_SHIN_E6_attach;
        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);
    }
}