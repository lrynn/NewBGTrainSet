/*------------------------------------------------------------------------------
    SILLIM
------------------------------------------------------------------------------*/

// Graphics
#include "sillim_graphic.pnml"

// Switch
#include "sillim_switch.pnml"

// Item
item(FEAT_TRAINS, SILLIM, 7203) {
    property {
        // Common properties
        name:                           string(STR_SILLIM_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SILLIM_INTRODUCTION;
        track_type:                     KR_3RD_RAIL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;

        // Spec
        power:                          var_SILLIM_POWER;
        weight:                         var_SILLIM_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;
        length:                         5;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }
    graphics {
        default:                        sw_SILLIM;
        articulated_part:               sw_articulated_SILLIM;
        purchase:                       set_SILLIM_purchase;

        speed:                          var_SILLIM_SPEED;
        cost_factor:                    var_SILLIM_COST;
        running_cost_factor:            var_SILLIM_RUNNINGCOST;
        cargo_capacity:                 var_SILLIM_CAPACITY;
        purchase_cargo_capacity:        var_SILLIM_CAPACITY;
        loading_speed:                  var_SILLIM_LOADINGSPEED;

        can_attach_wagon:               sw_METRO_attach_global;
        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);

        sound_effect:                   sw_SILLIM_sound;
    }
}