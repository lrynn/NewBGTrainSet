------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SILLIM, position_in_vehid_chain % 3) {
    1:set_SILLIM_wagon;
    2:set_SILLIM_engineT;
    set_SILLIM_engineH;
    }
