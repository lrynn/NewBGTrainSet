/*------------------------------------------------------------------------------
  SUX-2
------------------------------------------------------------------------------*/

// Graphics
#include "sux2_graphic.pnml"

// Switches
#include "sux2_switch.pnml"

item(FEAT_TRAINS, SUX2, 1100) {
    property {
        // Common properties
        name:                           string(STR_SUX2_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SUX2_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_sux;

        // Spec
        speed:                          var_SUX2_SPEED;
        power:                          var_SUX2_POWER;
        weight:                         var_SUX2_WEIGHT;
        tractive_effort_coefficient:    0.4;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
    }
    graphics {
        default:                        sw_SUX2_reversed;
        articulated_part:               sw_articulated_SUX2;
        purchase:                       set_SUX2_purchase;

        speed:                          var_SUX2_SPEED;
        cost_factor:                    var_SUX2_COST;
        running_cost_factor:            var_SUX2_RUNNINGCOST;
        cargo_capacity:                 var_SUX2_CAPACITY;
        purchase_cargo_capacity:        var_SUX2_CAPACITY;
        loading_speed:                  var_SUX2_LOADINGSPEED;

        can_attach_wagon:               sw_SUX2_attach;
        cargo_subtype_text:             sw_SUX2_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_SUX2_sound;
    }
}