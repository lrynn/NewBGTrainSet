/*------------------------------------------------------------------------------
  SUX2 Graphics
------------------------------------------------------------------------------*/

// Template
template tmpl_SUX2_engine(x, y) {
    [x+0,      y,     8,    23,    -3,   -11]
    [x+20,     y,    22,    16,   -15,    -7]
    [x+50,     y,    32,    14,   -16,   -10]
    [x+90,     y,    22,    18,    -5,    -9]
    [x+120,    y,     8,    23,    -3,   -11]
    [x+140,    y,    22,    18,   -16,    -9]
    [x+170,    y,    32,    14,   -17,   -10]
    [x+210,    y,    22,    16,    -6,    -7]
}
template tmpl_SUX2_engine_r(x, y) {
    [x+120,    y,     8,    23,    -3,   -11]
    [x+140,    y,    22,    16,   -15,    -7]
    [x+170,    y,    32,    14,   -16,   -10]
    [x+210,    y,    22,    18,    -5,    -9]
    [x+0,      y,     8,    23,    -3,   -11]
    [x+20,     y,    22,    18,   -16,    -9]
    [x+50,     y,    32,    14,   -17,   -10]
    [x+90,     y,    22,    16,    -6,    -7]
}

// SUX2 (KTX-Sancheon)
spriteset(set_SUX2_purchase, "./src/sux/sux2/SUX2.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_SUX2_engineH, "./src/sux/sux2/SUX2.png") {   // PC1
    tmpl_SUX2_engine(80, 0)
}
spriteset(set_SUX2_wagon_1, "./src/sux/sux2/SUX2.png") {   // T1
    tmpl_KTXloco_power(80, 30)
}
spriteset(set_SUX2_wagon_express, "./src/sux/sux2/SUX2.png") {   // T3, express car
    tmpl_KTXloco_wagon(80, 60)
}
spriteset(set_SUX2_wagon_express_r, "./src/sux/sux2/SUX2.png") {   // T3, express car (reverse)
    tmpl_KTXloco_wagon_r(80, 60)
}
spriteset(set_SUX2_wagon_middle, "./src/sux/sux2/SUX2.png") {  // T2, T4 ~ T7
    tmpl_KTXloco_wagon(80, 90)
}
spriteset(set_SUX2_wagon_8, "./src/sux/sux2/SUX2.png") {   // T8
    tmpl_KTXloco_power(80, 120)
}
spriteset(set_SUX2_engineT, "./src/sux/sux2/SUX2.png") {   // PC2
    tmpl_SUX2_engine(80, 150)
}

// KTX-Sancheon for 2018 Pyeongchang Olympic
spriteset(set_SUX2_PEYONGCHANG_purchase, "./src/sux/sux2/sux2_pyeongchang.png") {
