/*------------------------------------------------------------------------------
    SUX-3 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SUX3, position_in_vehid_chain % 8) {
    1:set_SUX3_wagon_4;
    2:set_SUX3_wagon_3;
    3:set_SUX3_wagon_3_without_panto;
    4..5:set_SUX3_wagon_3;
    6:set_SUX3_wagon_2;
    7:set_SUX3_engineT;
    set_SUX3_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SUX3_r, position_in_vehid_chain % 8) {
    1:set_SUX3_wagon_4;
    2:set_SUX3_wagon_3;
    3:set_SUX3_wagon_3_without_panto;
    4..5:set_SUX3_wagon_3;
    6:set_SUX3_wagon_2;
    7:set_SUX3_engineT;
    set_SUX3_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SUX3_flipped, vehicle_is_flipped){
    0: sw_SUX3_r;
    sw_SUX3;
}
switch(FEAT_TRAINS, PARENT, sw_SUX3_reversed, vehicle_is_reversed){
    0: sw_SUX3;
    sw_SUX3_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SUX3, extra_callback_info1) {
    1..7: SUX3;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SUX3_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1Kstart.wav");
    return CB_RESULT_NO_SOUND;
}