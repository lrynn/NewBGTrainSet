/*------------------------------------------------------------------------------
    SUX3 Graphics
------------------------------------------------------------------------------*/

spriteset(set_SUX3_purchase, "./src/sux/sux3/sux3.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_SUX3_engineH, "./src/sux/sux3/sux3.png") {
    tmpl_standard(80, 0)
}
spriteset(set_SUX3_wagon_2, "./src/sux/sux3/sux3.png") { // 팬터ㄴ
    tmpl_standard(80, 30)
}
spriteset(set_SUX3_wagon_3, "./src/sux/sux3/sux3.png") { // 민둥이
    tmpl_standard(80, 60)
}
spriteset(set_SUX3_wagon_4, "./src/sux/sux3/sux3.png") { // 팬터
    tmpl_standard(80, 90)
}
spriteset(set_SUX3_engineT, "./src/sux/sux3/sux3.png") {
    tmpl_standard_r(80, 120)
}
spriteset(set_SUX3_wagon_3_without_panto, "./src/sux/sux3/sux3.png") { // 민둥이 리버스
    tmpl_standard(80, 150)
}

// Enhanced graphic using 32bpp
