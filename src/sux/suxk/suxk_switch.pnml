/*------------------------------------------------------------------------------
    SUX-KKEUNEUM Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SUXK, position_in_vehid_chain % 6) {
    1:set_SUXK_wagon_2;
    2..3:set_SUXK_wagon_3;
    4:set_SUXK_wagon_4;
    5:set_SUXK_engineT;
    set_SUXK_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SUXK_r, position_in_vehid_chain % 6) {
    1:set_SUXK_wagon_2;
    2..3:set_SUXK_wagon_3;
    4:set_SUXK_wagon_4;
    5:set_SUXK_engineT;
    set_SUXK_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SUXK_flipped, vehicle_is_flipped){
    0: sw_SUXK_r;
    sw_SUXK;
}
switch(FEAT_TRAINS, PARENT, sw_SUXK_reversed, vehicle_is_reversed){
    0: sw_SUXK;
    sw_SUXK_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SUXK, extra_callback_info1) {
    1..5: SUXK;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SUXK_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1Kstart.wav");
    return CB_RESULT_NO_SOUND;
}