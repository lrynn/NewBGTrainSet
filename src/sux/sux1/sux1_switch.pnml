/*------------------------------------------------------------------------------
  SUX-1 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SUX1, position_in_vehid_chain % 20) {
    1:set_SUX1_wagon_1;
    2..4:set_SUX1_wagon_express;
    5..9:set_SUX1_wagon_middle1;
    10..17:set_SUX1_wagon_middle2;
    18:set_SUX1_wagon_18;
    19:set_SUX1_engineT_r;
    set_SUX1_engineH;
}
switch (FEAT_TRAINS, SELF, sw_SUX1_r, position_in_vehid_chain % 20) {
    1:set_SUX1_wagon_1;
    2..4:set_SUX1_wagon_express;
    5..9:set_SUX1_wagon_middle1;
    10..17:set_SUX1_wagon_middle2;
    18:set_SUX1_wagon_18;
    19:set_SUX1_engineT_r;
    set_SUX1_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SUX1_flipped, vehicle_is_flipped){
    0: sw_SUX1_r;
    sw_SUX1;
}
switch(FEAT_TRAINS, PARENT, sw_SUX1_reversed, vehicle_is_reversed){
    0: sw_SUX1;
    sw_SUX1_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SUX1, extra_callback_info1) {
    1..19: SUX1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SUX1_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TGV_Kstart.wav");
    return CB_RESULT_NO_SOUND;
}