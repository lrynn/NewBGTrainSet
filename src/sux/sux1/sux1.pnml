/*------------------------------------------------------------------------------
  SUX-1
------------------------------------------------------------------------------*/

// Graphics
#include "sux1_graphic.pnml"

// Switches
#include "sux1_switch.pnml"

item(FEAT_TRAINS, SUX1, 1000) {
    property {
        // Common properties
        name:                           string(STR_SUX1_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_SUX1_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_sux;

        // Spec
        speed:                          var_SUX1_SPEED;
        power:                          var_SUX1_POWER;
        weight:                         var_SUX1_WEIGHT;
        tractive_effort_coefficient:    0.4;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }
    graphics {
        default:                        sw_SUX1_reversed;
        articulated_part:               sw_articulated_SUX1;
        purchase:                       set_SUX1_purchase;

        speed:                          var_SUX1_SPEED;
        cost_factor:                    var_SUX1_COST;
        running_cost_factor:            var_SUX1_RUNNINGCOST;
        cargo_capacity:                 var_SUX1_CAPACITY;
        purchase_cargo_capacity:        var_SUX1_CAPACITY;
        loading_speed:                  var_SUX1_LOADINGSPEED;

        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);

        sound_effect:                   sw_SUX1_sound;
    }
}