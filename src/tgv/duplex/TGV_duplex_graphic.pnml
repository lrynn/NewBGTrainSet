/*--------------------------------------------------------------------
    TGV Duplex Graphics
--------------------------------------------------------------------*/


// TGV Duplex

spriteset(set_TGV_duplex_purchase, "src/tgv/duplex/TGV_duplex.png"){
    tmpl_purchase(0, 0)
}
spriteset(set_TGV_duplex_engineH, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp(80, 0)
}
spriteset(set_TGV_duplex_engineH_r, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp(80, 27)
}
spriteset(set_TGV_duplex_wagon_F1, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp(80, 54)
}
spriteset(set_TGV_duplex_wagon_F1_r, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp_r(80, 54)
}
spriteset(set_TGV_duplex_wagon_C, "src/tgv/duplex/TGV_duplex.png") {
    DTS_temp(80, 108)
}
spriteset(set_TGV_duplex_wagon_C_r, "src/tgv/duplex/TGV_duplex.png") {
    DTS_temp_r(80, 108)
}
spriteset(set_TGV_duplex_wagon_T1, "src/tgv/duplex/TGV_duplex.png") {
    DTS_temp(80, 135)
}
spriteset(set_TGV_duplex_wagon_T1_r, "src/tgv/duplex/TGV_duplex.png") {
    DTS_temp_r(80, 135)
}
spriteset(set_TGV_duplex_engineT_r, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp(80, 189)
}
spriteset(set_TGV_duplex_engineT, "src/tgv/duplex/TGV_duplex.png"){
    DTS_temp(80, 216)
}

