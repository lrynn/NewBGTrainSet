/*------------------------------------------------------------------------------
    TGV DUPLEX Series
------------------------------------------------------------------------------*/

// Graphics
#include "TGV_duplex_graphic.pnml"

// Switches
#include "TGV_duplex_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/

item(FEAT_TRAINS, group_TGV_DUPLEX, 6701) {
    property {
        name:                           string(STR_group_TGV_DUPLEX_NAME);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          1 kW;
        
        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }

    graphics {
        purchase:                       set_TGV_duplex_purchase;
    }
}

/*--------------------------------------------------------------------
열차 리스트
--------------------------------------------------------------------*/

item(FEAT_TRAINS, TGV_DUPLEX, 6700) {
    property {
        // Common properties
        name:                           string(STR_TGV_DUPLEX_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_TGV_DUPLEX_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_TGV_DUPLEX;

        // Spec
        speed:                          var_TGV_DUPLEX_SPEED;
        power:                          var_TGV_DUPLEX_POWER;
        weight:                         var_TGV_DUPLEX_WEIGHT;
        tractive_effort_coefficient:    0.4;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }
    graphics {
        default:                        sw_TGV_duplex_reversed;
        articulated_part:               sw_articulated_TGV_DUPLEX;
        purchase:                       set_TGV_duplex_purchase;

        speed:                          var_TGV_DUPLEX_SPEED;
        cost_factor:                    var_TGV_DUPLEX_COST;
        running_cost_factor:            var_TGV_DUPLEX_RUNNINGCOST;
        cargo_capacity:                 var_TGV_DUPLEX_CAPACITY;
        purchase_cargo_capacity:        var_TGV_DUPLEX_CAPACITY;
        loading_speed:                  var_TGV_DUPLEX_LOADINGSPEED;

        cargo_subtype_text:             sw_TGV_DUPLEX_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_TGV_duplex_1st_sound;
    }
}

