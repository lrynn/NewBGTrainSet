    1: return set_TGV_duplex_carmillon_wagon_T1_r;
    2: return set_TGV_duplex_lyria_wagon_T1_r;
    3: return set_TGV_duplex_ouigo_wagon_T1_r;
    // 4: return set_TGV_duplex_ONCF_wagon_T1_r; <- ONCF 도입 시 추가
    return set_TGV_duplex_wagon_T1_r;
