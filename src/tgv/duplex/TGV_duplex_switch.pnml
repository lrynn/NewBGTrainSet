    1: return set_TGV_duplex_carmillon_wagon_F1;
    2: return set_TGV_duplex_lyria_wagon_F1;
    3: return set_TGV_duplex_ouigo_wagon_F1;
    // 4: return set_TGV_duplex_ONCF_wagon_F1; <- ONCF 도입 시 추가
