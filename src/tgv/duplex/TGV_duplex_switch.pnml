switch(FEAT_TRAINS, SELF, sw_TGV_duplex_engineT, cargo_subtype) {
    1: return set_TGV_duplex_carmillon_engineT;
    2: return set_TGV_duplex_lyria_engineT;
    3: return set_TGV_duplex_ouigo_engineT;
    // 4: return set_TGV_duplex_ONCF_engineT; <- ONCF 도입 시 추가
    return set_TGV_duplex_engineT;
}
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_engineT_r, cargo_subtype) {
    1: return set_TGV_duplex_carmillon_engineT_r;
    2: return set_TGV_duplex_lyria_engineT_r;
    3: return set_TGV_duplex_ouigo_engineT_r;
    // 4: return set_TGV_duplex_ONCF_engineT_r; <- ONCF 도입 시 추가
    return set_TGV_duplex_engineT_r;
