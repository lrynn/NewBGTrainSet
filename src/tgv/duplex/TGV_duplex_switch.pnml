    1: return set_TGV_duplex_carmillon_wagon_C_r;
    2: return set_TGV_duplex_lyria_wagon_C_r;
    3: return set_TGV_duplex_ouigo_wagon_C_r;
    // 4: return set_TGV_duplex_ONCF_wagon_C_r; <- ONCF 도입 시 추가
    return set_TGV_duplex_wagon_C_r;
}
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_wagon_T1, cargo_subtype) {
    1: return set_TGV_duplex_carmillon_wagon_T1;
    2: return set_TGV_duplex_lyria_wagon_T1;
    3: return set_TGV_duplex_ouigo_wagon_T1;
    // 4: return set_TGV_duplex_ONCF_wagon_T1; <- ONCF 도입 시 추가
    return set_TGV_duplex_wagon_T1;
