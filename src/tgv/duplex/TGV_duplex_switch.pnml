/*------------------------------------------------------------------------------
    TGV Duplex Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_TGV_DUPLEX_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_TGV_CARMILLON_NAME);
    // 2: return string(STR_REFIT_TGV_OUIGO_NAME);
    // 3: return string(STR_REFIT_TGV_LYRIA_NAME);
    return string(STR_REFIT_TGV_ATLANTIC_BLUE_NAME);
}
switch(FEAT_TRAINS, SELF, sw_TGV_RESEAU_DUPLEX_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_TGV_CARMILLON_NAME);
    // 2: return string(STR_REFIT_TGV_LYRIA_NAME);
    // 3: return string(STR_REFIT_TGV_OUIGO_NAME);
    return string(STR_REFIT_TGV_ATLANTIC_BLUE_NAME);
}
switch(FEAT_TRAINS, SELF, sw_TGV_DUPLEX_DASYE_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_TGV_CARMILLON_NAME);
    // 2: return string(STR_REFIT_TGV_LYRIA_NAME);
    3: return string(STR_REFIT_TGV_OUIGO_NAME);
    return string(STR_REFIT_TGV_ATLANTIC_BLUE_NAME);
}
switch(FEAT_TRAINS, SELF, sw_TGV_2N2_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_TGV_CARMILLON_NAME);
    2: return string(STR_REFIT_TGV_LYRIA_NAME);
    // 3: return string(STR_REFIT_TGV_OUIGO_NAME);
    // 4: return string(STR_REFIT_ONCF_NAME); <- ONCF 도입 시 추가
    return string(STR_REFIT_TGV_ATLANTIC_BLUE_NAME);
}

switch(FEAT_TRAINS, SELF, sw_TGV_duplex_engineH, cargo_subtype) {
    1: return set_TGV_duplex_carmillon_engineH;
    2: return set_TGV_duplex_lyria_engineH;
    3: return set_TGV_duplex_ouigo_engineH;
    // 4: return set_TGV_duplex_ONCF_engineH; <- ONCF 도입 시 추가
    return set_TGV_duplex_engineH;
}
