    1: return set_TGV_duplex_carmillon_engineH_r;
    2: return set_TGV_duplex_lyria_engineH_r;
    3: return set_TGV_duplex_ouigo_engineH_r;
    // 4: return set_TGV_duplex_ONCF_engineH_r; <- ONCF 도입 시 추가
    return set_TGV_duplex_engineH_r;
}
