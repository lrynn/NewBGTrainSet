    return set_TGV_duplex_wagon_F1_r;
}
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_wagon_C, cargo_subtype) {
    1: return set_TGV_duplex_carmillon_wagon_C;
    2: return set_TGV_duplex_lyria_wagon_C;
