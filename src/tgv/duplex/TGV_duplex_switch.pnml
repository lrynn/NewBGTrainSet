// Train Composition
switch (FEAT_TRAINS, SELF, sw_TGV_duplex, position_in_vehid_chain % 10) {
    1..3: sw_TGV_duplex_wagon_F1;
    4: sw_TGV_duplex_wagon_C;
    5..8: sw_TGV_duplex_wagon_T1;
    9:sw_TGV_duplex_engineT;
    sw_TGV_duplex_engineH;
}
switch (FEAT_TRAINS, SELF, sw_TGV_duplex_r, position_in_vehid_chain % 10) {
    1..4: sw_TGV_duplex_wagon_T1_r;
    5: sw_TGV_duplex_wagon_C_r;
    6..8: sw_TGV_duplex_wagon_F1_r;
    9:sw_TGV_duplex_engineT_r;
    sw_TGV_duplex_engineH_r;
}
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_flipped, vehicle_is_flipped){
    0: sw_TGV_duplex_r;
    sw_TGV_duplex;
}
switch(FEAT_TRAINS, PARENT, sw_TGV_duplex_reversed, vehicle_is_reversed){
    0: sw_TGV_duplex;
    sw_TGV_duplex_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_TGV_DUPLEX, extra_callback_info1) {
    1..9: TGV_DUPLEX;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_TGV_RESEAU_DUPLEX, extra_callback_info1) {
    1..9: TGV_RESEAU_DUPLEX;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_TGV_DUPLEX_DASYE, extra_callback_info1) {
    1..9: TGV_DUPLEX_DASYE;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_TGV_2N2, extra_callback_info1) {
    1..9: TGV_2N2;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_1st_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TGV_Kstart.wav");
    return CB_RESULT_NO_SOUND;
}
switch(FEAT_TRAINS, SELF, sw_TGV_duplex_2nd_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TGV_POS_IGBT_start.wav");
    return CB_RESULT_NO_SOUND;
}