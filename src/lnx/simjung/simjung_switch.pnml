/*------------------------------------------------------------------------------
  lnx-simjung Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SIMJUNG_4car, position_in_vehid_chain % 4) {
    1:set_simjung_wagon_panto1;
    2:set_simjung_wagon_panto2;
    3:set_simjung_engineT_r;
    set_simjung_engineH;
}
switch (FEAT_TRAINS, SELF, sw_SIMJUNG_4car_r, position_in_vehid_chain % 4) {
    1:set_simjung_wagon_panto1;
    2:set_simjung_wagon_panto2;
    3:set_simjung_engineT_r;
    set_simjung_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SIMJUNG_4car_flipped, vehicle_is_flipped){
    0: sw_SIMJUNG_4car_r;
    sw_SIMJUNG_4car;
}
switch(FEAT_TRAINS, PARENT, sw_SIMJUNG_4car_reversed, vehicle_is_reversed){
    0: sw_SIMJUNG_4car;
    sw_SIMJUNG_4car_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SIMJUNG_6car, position_in_vehid_chain % 6) {
    1:set_simjung_wagon_panto1;
    2:set_simjung_wagon;
    3:set_simjung_wagon;
    4:set_simjung_wagon_panto2;
    5:set_simjung_engineT_r;
    set_simjung_engineH;
}
switch (FEAT_TRAINS, SELF, sw_SIMJUNG_6car_r, position_in_vehid_chain % 6) {
    1:set_simjung_wagon_panto1;
    2:set_simjung_wagon;
    3:set_simjung_wagon;
    4:set_simjung_wagon_panto2;
    5:set_simjung_engineT_r;
    set_simjung_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SIMJUNG_6car_flipped, vehicle_is_flipped){
    0: sw_SIMJUNG_6car_r;
    sw_SIMJUNG_6car;
}
switch(FEAT_TRAINS, PARENT, sw_SIMJUNG_6car_reversed, vehicle_is_reversed){
    0: sw_SIMJUNG_6car;
    sw_SIMJUNG_6car_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SIMJUNG_4car, extra_callback_info1) {
    1..3: SIMJUNG_4car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_SIMJUNG_6car, extra_callback_info1) {
    1..5: SIMJUNG_6car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// allow attatchment
switch(FEAT_TRAINS, SELF, sw_SIMJUNG_attach, vehicle_type_id) {
    SIMJUNG_4car: return CB_RESULT_ATTACH_ALLOW;
    SIMJUNG_6car: return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SIMJUNG_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/DAWONSYSIGBT2start.wav");
    return CB_RESULT_NO_SOUND;
}