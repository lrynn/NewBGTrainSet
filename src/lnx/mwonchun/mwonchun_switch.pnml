/*------------------------------------------------------------------------------
  lnx-mwonchun Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_MWONCHUN, position_in_vehid_chain % 8) {
    1:set_MWONCHUN_wagon_6;
    2:set_MWONCHUN_wagon_5;
    3:set_MWONCHUN_wagon_4;
    4:set_MWONCHUN_wagon_3;
    5:set_MWONCHUN_wagon_2;
    6:set_MWONCHUN_wagon_1;
    7:set_MWONCHUN_engineT_r;
    set_MWONCHUN_engineH;
}
switch (FEAT_TRAINS, SELF, sw_MWONCHUN_r, position_in_vehid_chain % 8) {
    1:set_MWONCHUN_wagon_6;
    2:set_MWONCHUN_wagon_5;
    3:set_MWONCHUN_wagon_4;
    4:set_MWONCHUN_wagon_3;
    5:set_MWONCHUN_wagon_2;
    6:set_MWONCHUN_wagon_1;
    7:set_MWONCHUN_engineT_r;
    set_MWONCHUN_engineH;
}
switch(FEAT_TRAINS, SELF, sw_MWONCHUN_flipped, vehicle_is_flipped){
    0: sw_MWONCHUN_r;
    sw_MWONCHUN;
}
switch(FEAT_TRAINS, PARENT, sw_MWONCHUN_reversed, vehicle_is_reversed){
    0: sw_MWONCHUN;
    sw_MWONCHUN_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_MWONCHUN, extra_callback_info1) {
    1..7: MWONCHUN;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_MWONCHUN_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TOSHIBAStart.wav");
    return CB_RESULT_NO_SOUND;
}