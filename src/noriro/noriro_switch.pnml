/*------------------------------------------------------------------------------
    NORIRO Switches
------------------------------------------------------------------------------*/

switch(FEAT_TRAINS, SELF, sw_NORIRO_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_LIVERY_NURIRO_KOREAN_WAVE);   // Korean wave livery
    2: return string(STR_REFIT_LIVERY_O_TRAIN);              // O-train
    3: return string(STR_REFIT_LIVERY_NURIRO_SANTA);         // Donghae Santa livery
    4: return string(STR_REFIT_LIVERY_NURIRO_2022);          // 2022 livery
    return string(STR_REFIT_LIVERY_NURIRO);
}

switch(FEAT_TRAINS, SELF, sw_NORIRO_engineH, cargo_subtype) {
    1: return set_NORIRO_KOREAN_WAVE_engineH;
    2: return set_NORIRO_O_TRAIN_engineH;
    3: return set_NORIRO_santa_engineH;
    4: return set_NORIRO_2022_engineH;
    return set_NORIRO_engineH;
}
switch(FEAT_TRAINS, SELF, sw_NORIRO_wagon_panto, cargo_subtype) {
    1: return set_NORIRO_KOREAN_WAVE_wagon_panto;
    2: return set_NORIRO_O_TRAIN_wagon_panto;
    3: return set_NORIRO_santa_wagon_panto;
    4: return set_NORIRO_2022_wagon_panto;
    return set_NORIRO_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_NORIRO_wagon, cargo_subtype) {
    1: return set_NORIRO_KOREAN_WAVE_wagon;
    2: return set_NORIRO_O_TRAIN_wagon;
    3: return set_NORIRO_santa_wagon;
    4: return set_NORIRO_2022_wagon;
    return set_NORIRO_wagon;
}
switch(FEAT_TRAINS, SELF, sw_NORIRO_engineT, cargo_subtype) {
    1: return set_NORIRO_KOREAN_WAVE_engineT;
    2: return set_NORIRO_O_TRAIN_engineT;
    3: return set_NORIRO_santa_engineT;
    4: return set_NORIRO_2022_engineT;
    return set_NORIRO_engineT;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_NORIRO, position_in_vehid_chain % 4) {
    1:sw_NORIRO_wagon_panto;
    2:sw_NORIRO_wagon;
    3:sw_NORIRO_engineT;
    sw_NORIRO_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_NORIRO_r, position_in_vehid_chain % 4) {
    1:sw_NORIRO_wagon_panto;
    2:sw_NORIRO_wagon;
    3:sw_NORIRO_engineT;
    sw_NORIRO_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_NORIRO_flipped, vehicle_is_flipped){
    0: sw_NORIRO_r;
    sw_NORIRO;
}
switch(FEAT_TRAINS, PARENT, sw_NORIRO_reversed, vehicle_is_reversed){
    0: sw_NORIRO;
    sw_NORIRO_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_NORIRO, extra_callback_info1) {
    1..3: NORIRO;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// allow attatchment
switch(FEAT_TRAINS, SELF, sw_NORIRO_attach, vehicle_type_id) {
    NORIRO: return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_NORIRO_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HITACHIStart.wav");
    return CB_RESULT_NO_SOUND;
}