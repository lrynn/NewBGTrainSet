/*------------------------------------------------------------------------------
    NORIRO Graphics
------------------------------------------------------------------------------*/

// Template
template tmpl_NURIRO_engine(x, y) {
    [x+0,     y,    8,     22,    -3,   -11]
    [x+20,    y,    21,    17,    -14,   -9]
    [x+50,    y,    31,    12,    -13,   -8]
    [x+90,    y,    21,    17,    -8,    -9]
    [x+120,   y,    8,     22,    -3,   -11]
    [x+140,   y,    21,    17,    -14,   -9]
    [x+170,   y,    31,    12,    -13,   -8]
    [x+210,   y,    21,    17,    -8,    -9]
}
template tmpl_NURIRO_wagon(x, y) {
    [x+0,     y,    8,     22,    -3,   -11]
    [x+20,    y,    21,    17,    -14,   -9]
    [x+50,    y,    31,    12,    -13,   -8]
    [x+90,    y,    21,    17,    -8,    -9]
}
template tmpl_NURIRO_wagon_8dir(x, y) {
    [x+0,     y,    8,     22,    -3,   -11]
    [x+20,    y,    21,    17,    -14,   -9]
    [x+50,    y,    31,    12,    -13,   -8]
    [x+90,    y,    21,    17,    -8,    -9]
    [x+120,   y,    8,     22,    -3,   -11]
    [x+140,   y,    21,    17,    -14,   -9]
    [x+170,   y,    31,    12,    -13,   -8]
    [x+210,   y,    21,    17,    -8,    -9]
}
template tmpl_NURIRO_wagon_panto(x, y) {
    [x+0,     y,    8,     22,    -3,   -11]
    [x+20,    y,    21,    17,    -14,   -9]
    [x+50,    y,    31,    15,    -13,  -11]
    [x+90,    y,    21,    18,    -8,   -10]
    [x+120,   y,    8,     22,    -3,   -11]
    [x+140,   y,    21,    18,    -14,  -10]
    [x+170,   y,    31,    15,    -13,  -11]
    [x+210,   y,    21,    17,    -8,    -9]
}

// Graphics
spriteset(set_NORIRO_purchase, "./src/noriro/noriro.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_NORIRO_engineH, "./src/noriro/noriro.png") {
    tmpl_NURIRO_engine(80, 0)
}
spriteset(set_NORIRO_wagon_panto, "./src/noriro/noriro.png") {
    tmpl_NURIRO_wagon_panto(80, 30)
}
spriteset(set_NORIRO_wagon, "./src/noriro/noriro.png") {
    tmpl_NURIRO_wagon_8dir(80, 60)
}
spriteset(set_NORIRO_engineT, "./src/noriro/noriro.png") {
    tmpl_NURIRO_engine(80, 90)
}

