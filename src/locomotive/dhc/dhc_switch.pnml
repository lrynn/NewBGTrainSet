/*------------------------------------------------------------------------------
    DHC - Switches
------------------------------------------------------------------------------*/

// Cargo subtype
// Same as sw_SAEMAEUL_CAR_subtype_text
switch(FEAT_TRAINS, SELF, sw_DHC_subtype_text, cargo_subtype) {
    2: return string(STR_REFIT_LIVERY_SAEMAEUL_1970_1983);
    4: return string(STR_REFIT_LIVERY_SAEMAEUL_GREEN_YELLOW);
    6: return string(STR_REFIT_LIVERY_SAEMAEUL_RACKRAIL);
    8: return string(STR_REFIT_LIVERY_GYEONGBOK);
    return string(STR_REFIT_LIVERY_SAEMAEUL_RACKRAIL);
}

// Refit Paintings
switch(FEAT_TRAINS, SELF, sw_DHC_engineH, cargo_subtype) {
    2: set_DHC_1_engineH;
    4: set_DHC_2_engineH;
    6: set_DHC_3_engineH;
    8: set_DHC_NEWMAEUL_engineH;
    set_DHC_3_engineH;
}
switch(FEAT_TRAINS, SELF, sw_DHC_engineT, cargo_subtype) {
    2: set_DHC_1_engineT;
    4: set_DHC_2_engineT;
    6: set_DHC_3_engineT;
    8: set_DHC_NEWMAEUL_engineT;
    set_DHC_3_engineT;
}
switch(FEAT_TRAINS, SELF, sw_DHC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DHC_engineT;
    sw_DHC_engineH;
}

// Attach
switch(FEAT_TRAINS, SELF, sw_DHC_attach, vehicle_type_id) {
    DHC:                    return CB_RESULT_ATTACH_ALLOW;
    ko_train_SAEMAEUL_CAR:  return CB_RESULT_ATTACH_ALLOW;
    ko_train_CAFE_CAR:      return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}
switch(FEAT_TRAINS, SELF, sw_DHC_attach_global, bool_no_vehicle_attachment_restrictions) {
    1: return CB_RESULT_ATTACH_ALLOW;
    sw_DHC_attach;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DHC_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/MTU396TCstart.wav");
    return CB_RESULT_NO_SOUND;
}