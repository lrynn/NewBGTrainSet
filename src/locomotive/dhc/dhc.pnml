/*------------------------------------------------------------------------------
    DHC
------------------------------------------------------------------------------*/

// Graphics
#include "dhc_graphic.pnml"

// Switch
#include "dhc_switch.pnml"

// Item
item(FEAT_TRAINS, DHC, 5520) {
    property {
        // Common properties
        name:                           string(STR_DHC_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_DHC_INTRODUCTION;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        dual_headed:                    1;

        // Spec
        speed:                          var_DHC_SPEED;
        power:                          var_DHC_POWER;
        weight:                         var_DHC_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
        visual_effect_and_powered:      VISUAL_EFFECT_DIESEL;
    }
    graphics {
        default:                        sw_DHC_engine;
        purchase:                       set_DHC_3_purchase;

        speed:                          var_DHC_SPEED;
        cost_factor:                    var_DHC_COST;
        running_cost_factor:            var_DHC_RUNNINGCOST;
        cargo_capacity:                 var_DHC_CAPACITY;
        purchase_cargo_capacity:        var_DHC_CAPACITY;
        loading_speed:                  var_DHC_LOADINGSPEED;

        can_attach_wagon:               sw_DHC_attach_global;
        cargo_subtype_text:             sw_DHC_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_DHC_sound;
    }
    livery_override(ko_train_CAFE_CAR) {
        default:                        sw_DHC_CAFE_CAR;
        cargo_capacity:                 sw_CAFE_CAR_capacity;
        loading_speed:                  sw_CAFE_CAR_loadingspeed;
        running_cost_factor:            sw_CAFE_CAR_runningcost;
        cargo_subtype_text:             sw_DHC_subtype_text;
    }
}
// End of "DHC(PP)"
