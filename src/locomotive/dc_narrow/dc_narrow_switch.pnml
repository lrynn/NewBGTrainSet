/*------------------------------------------------------------------------------
    DC_NARROW Switches
------------------------------------------------------------------------------*/

// Wagon
switch(FEAT_TRAINS, SELF, sw_DC_NARROW_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_LIVERY_BIDULGI_DC_TRAILER);
    2: return string(STR_REFIT_LIVERY_BIDULGI_NARROW_BLUE);
    3: return string(STR_REFIT_LIVERY_BIDULGI_TONGIL_GREEN_1990);
    return string(STR_REFIT_LIVERY_BIDULGI_NARROW_BLUE);
}
switch(FEAT_TRAINS, SELF, sw_DC_NARROW_engine, cargo_subtype) {
    1: set_DC_NARROW_DC_TRAILER_engine;
    2: set_DC_NARROW_BLUE_engine;
    3: set_DC_NARROW_GREEN_engine;
    set_DC_NARROW_BLUE_engine;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DC_NARROW_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/Cummins_DMU_start.wav");
    SOUND_EVENT_STOPPED: sound("sounds/COMMINS_DMU_Idle.wav");
    return CB_RESULT_NO_SOUND;
}
