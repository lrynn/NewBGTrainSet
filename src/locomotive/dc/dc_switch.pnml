/*------------------------------------------------------------------------------
    DC Switches
------------------------------------------------------------------------------*/

// Cargo subtype
switch(FEAT_TRAINS, SELF, sw_DC_cargo_subtype_text, cargo_subtype) {
    2: return string(STR_REFIT_LIVERY_BIDULGI_DC_TRAILER);
    5: return string(STR_REFIT_LIVERY_BIDULGI_1980);
    6: return string(STR_REFIT_LIVERY_BIDULGI_1990);
    10: return string(STR_REFIT_LIVERY_BIDULGI_TONGIL_GREEN_1980);
    11: return string(STR_REFIT_LIVERY_BIDULGI_TONGIL_GREEN_1990);
    12: return string(STR_REFIT_LIVERY_BIDULGI_MUGUNGHWA);
    return string(STR_REFIT_LIVERY_BIDULGI_1980);
}

// Engine
switch(FEAT_TRAINS, SELF, sw_DC_engine, cargo_subtype) {
    2: set_DC_TRAILER_engine;
    5: set_DC_BLUE_engine;
    6: set_DC_LIGHT_GREEN_engine;
    10: set_DC_GREEN_engine;
    11: set_DC_TONGIL_GREEN_engine;
    12: set_DC_MUGUNGHWA_engine;
    set_DC_BLUE_engine;
}

// Attach
switch(FEAT_TRAINS, SELF, sw_DC_attach, vehicle_type_id) {
    DC: return CB_RESULT_ATTACH_ALLOW;
    ko_train_BIDULGI_CAR: return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}
switch(FEAT_TRAINS, SELF, sw_DC_attach_global, bool_no_vehicle_attachment_restrictions) {
    1: return CB_RESULT_ATTACH_ALLOW;
    sw_DC_attach;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DC_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/Cummins_DMU_start.wav");
    SOUND_EVENT_STOPPED: sound("sounds/COMMINS_DMU_Idle.wav");
    return CB_RESULT_NO_SOUND;
}