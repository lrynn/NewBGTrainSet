/*--------------------------------------------------------------------
성신RST 2000년식 MSB 모터카
--------------------------------------------------------------------*/
// Graphics
#include "MSB_Speeder_graphic.pnml"

// Switch
#include "MSB_Speeder_switch.pnml"

/*--------------------------------------------------------------------
열차정보
--------------------------------------------------------------------*/
item(FEAT_TRAINS, MSB, 4410){
    property {
        name:                           string(STR_MSB_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_MSB_INTRODUCTION;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        
        //spec
        speed:                          var_MSB_SPEED;
        power:                          var_MSB_POWER;
        weight:                         var_MSB_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.06;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        length:                         4;
        
        //Cargo
        cargo_capacity:                 0;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT);
    }
    
	graphics {
        default:                        sw_MSB_Speeder_engine_1Car;
        purchase:                       sw_MSB_Speeder_purchase;

        speed:                          var_MSB_SPEED;
        cost_factor:                    var_MSB_COST;
        running_cost_factor:            var_MSB_RUNNINGCOST;
        cargo_capacity:                 0;

        can_attach_wagon:               sw_Kxxxx_attach_global;
        additional_text:                string(STR_REFIT_ADDITIONAL_UNABLE);
    }
}