/*------------------------------------------------------------------------------
    8500 Switches
------------------------------------------------------------------------------*/

// Switch
// None

// Locomotive facing
switch (FEAT_TRAINS, SELF, sw_8500_reverse, position_in_consist % 2) {
    0: set_8500;
    1: set_8500_r;
    set_8500_r;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_8500_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/FEL8500Start.wav");
    return CB_RESULT_NO_SOUND;
}