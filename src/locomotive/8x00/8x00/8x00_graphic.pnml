// Red & White & Blue (current)
spriteset(set_8x00_RED_WHITE_BLUE_purchase, "./src/locomotive/8x00/8x00.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_8x00_RED_WHITE_BLUE, "./src/locomotive/8x00/8x00.png") {
    tmpl_standard(80, 0)
}

// Green & Yellow
spriteset(set_8x00_GREEN_YELLOW_purchase, "./src/locomotive/8x00/8x00.png") {
    tmpl_purchase_common(0, 30)
}
spriteset(set_8x00_GREEN_YELLOW, "./src/locomotive/8x00/8x00.png") {
    tmpl_standard(80, 30)
}

