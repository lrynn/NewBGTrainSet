/*------------------------------------------------------------------------------
  8x00 Switches
------------------------------------------------------------------------------*/
// Refit Paintings
switch(FEAT_TRAINS, SELF, sw_8x00_loco, cargo_subtype) {
    1:    set_8x00_GREEN_YELLOW;
    set_8x00_RED_WHITE_BLUE;
}
switch(FEAT_TRAINS, SELF, sw_8x00_cargo_subtype_text, cargo_subtype) {
    1:    return string(STR_REFIT_LIVERY_GREEN_YELLOW);
    return string(STR_REFIT_LIVERY_THESEDAYS);
}
// Alias of purchase image
switch(FEAT_TRAINS, SELF, sw_8x00_purchase, cargo_subtype) {
    set_8x00_RED_WHITE_BLUE_purchase;
}

// Sound
switch(FEAT_TRAINS, SELF, sw_8x00_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/SIEMENSGTOlocostart.wav");
    return CB_RESULT_NO_SOUND;
}