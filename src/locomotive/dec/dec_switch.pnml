/*------------------------------------------------------------------------------
    DEC Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_DEC_cargo_subtype_text, cargo_subtype) {
    1:    return string(STR_REFIT_LIVERY_DEC_2); // 그래픽 파일이 무궁화-새마을-무궁화 순서로 돼있음
    2:    return string(STR_REFIT_LIVERY_DEC_1); // 원본 그래픽이 순서가 이럼
    3:    return string(STR_REFIT_LIVERY_DEC_3); // 내 잘못 아님
    return string(STR_REFIT_LIVERY_DEC_2);
}

// Train Composition
switch(FEAT_TRAINS, SELF, sw_DEC_engineH, cargo_subtype) {
    1:  set_DEC_2_engineH;
    2:  set_DEC_1_engineH;
    3:  set_DEC_3_engineH;
    set_DEC_2_engineH;
}
switch(FEAT_TRAINS, SELF, sw_DEC_engineT, cargo_subtype) {
    1:  set_DEC_2_engineT;
    2:  set_DEC_1_engineT;
    3:  set_DEC_3_engineT;
    set_DEC_2_engineT;
}
switch(FEAT_TRAINS, SELF, sw_DEC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DEC_engineT;
    sw_DEC_engineH;
}

switch(FEAT_TRAINS, SELF, sw_DEC_wagon, cargo_subtype) {
    1: set_DEC_2_wagon;
    2: set_DEC_1_wagon;
    3: set_DEC_3_wagon;
    set_DEC_2_wagon;
}

switch(FEAT_TRAINS, SELF, sw_DEC_current, position_in_vehid_chain_from_end == 0 || position_in_vehid_chain == 0) {
    1: sw_DEC_engine;
    0: sw_DEC_wagon;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_DEC, extra_callback_info1) {
    1..4: DEC;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Attach
switch(FEAT_TRAINS, SELF, sw_DEC_attach, vehicle_type_id) {
    return string(STR_ERROR_NO_ATTACH);
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DEC_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/Cummins_DMU_start.wav");
    SOUND_EVENT_STOPPED: sound("sounds/COMMINS_DMU_Idle.wav");
    return CB_RESULT_NO_SOUND;
}