/*------------------------------------------------------------------------------
    DEC
------------------------------------------------------------------------------*/

// Graphics
#include "dec_graphic.pnml"

// Switch
#include "dec_switch.pnml"

// Item
item(FEAT_TRAINS, DEC, 2095) {
    property {
        // Common properties
        name:                           string(STR_DEC_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_DEC_INTRODUCTION;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;

        // Spec
        speed:                          var_DEC_SPEED;
        power:                          var_DEC_POWER;
        weight:                         var_DEC_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
        visual_effect_and_powered:      VISUAL_EFFECT_DIESEL;
    }
    graphics {
        default:                        sw_DEC_current;
        articulated_part:               sw_articulated_DEC;
        purchase:                       set_DEC_purchase;

        speed:                          var_DEC_SPEED;
        cost_factor:                    var_DEC_COST;
        running_cost_factor:            var_DEC_RUNNINGCOST;
        cargo_capacity:                 var_DEC_CAPACITY;
        purchase_cargo_capacity:        var_DEC_CAPACITY;
        loading_speed:                  var_DEC_LOADINGSPEED;

        can_attach_wagon:               sw_DEC_attach;
        cargo_subtype_text:             sw_DEC_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_DEC_sound;
    }
}