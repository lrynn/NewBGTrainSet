spriteset(set_EEC_1_engineH, "./src/locomotive/eec/eec.png") {   // Tc (front)
    tmpl_NDC(80, 0)
}
spriteset(set_EEC_1_engineT, "./src/locomotive/eec/eec.png") {   // Tc (rear)
    tmpl_NDC_r(80, 30)
}
