/*------------------------------------------------------------------------------
    CDC Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_CDC_cargo_subtype_text, cargo_subtype) {
    1:    return string(STR_REFIT_LIVERY_GREEN_YELLOW);          // 구 철도청(녹+황)
    2:    return string(STR_REFIT_LIVERY_CDC_DOLPHIN);           // Dolphin (돌고래)
    3:    return string(STR_REFIT_LIVERY_CDC_BAEKJE);            // Baekje (백제관광)
    4:    return string(STR_REFIT_LIVERY_CDC_GARDEN);            // Garden (꽃동네)
    5:    return string(STR_REFIT_LIVERY_CDC_SEASIDE_BLUE);      // Seaside (바다열차(청))
    6:    return string(STR_REFIT_LIVERY_CDC_SEASIDE_RED_WHITE); // Seaside (바다열차(적+백))
    7:    return string(STR_REFIT_LIVERY_CDC_DMZTRAIN);          // DMZ-train
    8:    return string(STR_REFIT_LIVERY_THESEDAYS);
    9:    return string(STR_REFIT_LIVERY_CDC_GYEONGBUK1);        // 경북관광열차#1
    10:   return string(STR_REFIT_LIVERY_CDC_GYEONGBUK2);        // 경북관광열차#2
    18:    return string(STR_REFIT_LIVERY_CDC_MUGUNGHWA);        // RDC
    return string(STR_REFIT_LIVERY_GREEN_YELLOW);
}

// Train Composition

// for Gyeongbuk Livery
switch(FEAT_TRAINS, SELF, sw_RDC_GYEONGBUK1_wagon, position_in_consist % 2) {
    1: set_RDC_GYEONGBUK1_wagon1;
    set_RDC_GYEONGBUK1_wagon2;
}
switch(FEAT_TRAINS, SELF, sw_RDC_GYEONGBUK2_wagon, position_in_consist % 2) {
    1: set_RDC_GYEONGBUK2_wagon2;
    set_RDC_GYEONGBUK2_wagon1;
}

switch(FEAT_TRAINS, SELF, sw_CDC_engineH, cargo_subtype) {
    1:  set_CDC_GREEN_YELLOW_engineH;
    2:  set_CDC_DOLPHIN_engineH;
    3:  set_CDC_BAEKJE_engineH;
    4:  set_CDC_GARDEN_engineH;
    5:  set_CDC_SEASIDE_BLUE_engineH;
    6:  set_CDC_SEASIDE_RED_WHITE_engineH;
    7:  set_CDC_DMZTRAIN_engineH;
    8:  set_CDC_engineH;
    9:  set_RDC_GYEONGBUK1_engineH;
    10: set_RDC_GYEONGBUK2_engineH;
    18: set_RDC_MUGUNGHWA_engineH;
    set_CDC_GREEN_YELLOW_engineH;
}
switch(FEAT_TRAINS, SELF, sw_CDC_engineT, cargo_subtype) {
    1:  set_CDC_GREEN_YELLOW_engineT;
    2:  set_CDC_DOLPHIN_engineT;
    3:  set_CDC_BAEKJE_engineT;
    4:  set_CDC_GARDEN_engineT;
    5:  set_CDC_SEASIDE_BLUE_engineT;
    6:  set_CDC_SEASIDE_RED_WHITE_engineT;
    7:  set_CDC_DMZTRAIN_engineT;
    8:  set_CDC_engineT;
    9:  set_RDC_GYEONGBUK1_engineT;
    10: set_RDC_GYEONGBUK2_engineT;
    18: set_RDC_MUGUNGHWA_engineT;
    set_CDC_GREEN_YELLOW_engineT;
}
switch(FEAT_TRAINS, SELF, sw_CDC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_CDC_engineT;
    sw_CDC_engineH;
}

switch(FEAT_TRAINS, SELF, sw_CDC_wagon, cargo_subtype) {
    1:  set_CDC_GREEN_YELLOW_wagon;
    2:  set_CDC_DOLPHIN_wagon;
    3:  set_CDC_BAEKJE_wagon;
    4:  set_CDC_GARDEN_wagon;
    5:  set_CDC_SEASIDE_BLUE_wagon;
    6:  set_CDC_SEASIDE_RED_WHITE_wagon;
    7:  set_CDC_DMZTRAIN_wagon;
    8:  set_CDC_wagon;
    9:  sw_RDC_GYEONGBUK1_wagon;
    10: sw_RDC_GYEONGBUK2_wagon;
    18: set_RDC_MUGUNGHWA_wagon;
    set_CDC_GREEN_YELLOW_wagon;
}

switch(FEAT_TRAINS, SELF, sw_CDC_current, position_in_vehid_chain_from_end == 0 || position_in_vehid_chain == 0) {
    1: sw_CDC_engine;
    0: sw_CDC_wagon;
}

// Length Limits

switch(FEAT_TRAINS, SELF, sw_CDC_length_limit, num_vehs_in_consist) {
    3 .. 5: return CB_RESULT_NO_TEXT;
    return string(STR_ERROR_CDC_LENGTH);
}

// Attachment
switch(FEAT_TRAINS, SELF, sw_CDC_attach, vehicle_type_id) {
    CDC:           return CB_RESULT_ATTACH_ALLOW;
    return string(STR_ERROR_NO_ATTACH);
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_CDC_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/Cummins_DMU_start.wav");
    SOUND_EVENT_STOPPED: sound("sounds/COMMINS_DMU_Idle.wav");
    return CB_RESULT_NO_SOUND;
}