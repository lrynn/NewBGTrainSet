/*--------------------------------------------------------------------
  7000 Graphics
--------------------------------------------------------------------*/

// White & Blue
spriteset(set_7000_SILVER_BLUE_purchase, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_7000_SILVER_BLUE, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_standard(80, 0)
}


// Green & Yellow
spriteset(set_7000_GREEN_YELLOW_purchase, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_purchase_common(0, 30)
}
spriteset(set_7000_GREEN_YELLOW, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_standard(80, 30)
}

// Red & White & Blue
spriteset(set_7000_RED_WHITE_BLUE_purchase, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_purchase_common(0, 60)
}
spriteset(set_7000_RED_WHITE_BLUE, "./src/locomotive/7x00/7000/7000.png") {
    tmpl_standard(80, 60)
}

// Alias of purchase image
switch(FEAT_TRAINS, SELF, sw_7000_purchase, cargo_subtype) {
    set_7000_RED_WHITE_BLUE_purchase;
}
