/*------------------------------------------------------------------------------
  7000 Switches
------------------------------------------------------------------------------*/

// Cargo subtype
switch(FEAT_TRAINS, SELF, sw_7000_cargo_subtype_text, cargo_subtype) {
    1:    return string(STR_REFIT_LIVERY_GREEN_YELLOW);
    2:    return string(STR_REFIT_LIVERY_7000_SILVER_BLUE);
    return string(STR_REFIT_LIVERY_THESEDAYS);
}
switch(FEAT_TRAINS, SELF, sw_7000_loco, cargo_subtype) {
    1:    set_7000_GREEN_YELLOW;
    2:    set_7000_SILVER_BLUE;
    set_7000_RED_WHITE_BLUE;
}
switch(FEAT_TRAINS, SELF, sw_7000_loco_r, cargo_subtype) {
    1:    set_7000_GREEN_YELLOW_r;
    2:    set_7000_SILVER_BLUE_r;
    set_7000_RED_WHITE_BLUE_r;
}

// Locomotive facing
switch (FEAT_TRAINS, SELF, sw_7000_loco_reverse, position_in_consist) {
    0..2: sw_7000_loco;
    sw_7000_loco_r;
}

// Sound Effects
switch(FEAT_TRAINS, SELF, sw_7000_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/DEL7000start.wav");
    SOUND_EVENT_STOPPED: sound("sounds/DEL7000Idle.wav");
    return CB_RESULT_NO_SOUND;
    }