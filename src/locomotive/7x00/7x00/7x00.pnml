/*------------------------------------------------------------------------------
  7x00
------------------------------------------------------------------------------*/

// Graphics
#include "7x00_graphic.pnml"

// Switch
#include "7x00_switch.pnml"

// item
item(FEAT_TRAINS, ko_train_7x00, 4710) {
    property {
        // Common properties
        name:                           string(STR_7x00_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_7x00_INTRODUCTION;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_7x00;

        // Spec
        speed:                          var_7x00_SPEED km/h;
        power:                          var_7x00_POWER;
        weight:                         var_7x00_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
        bitmask_vehicle_info:           0;
    }
    graphics {
        default:                        sw_7x00_loco_reverse;
        purchase:                       sw_7x00_purchase;

        speed:                          var_7x00_SPEED;
        cost_factor:                    var_7x00_COST;
        running_cost_factor:            var_7x00_RUNNINGCOST;
        cargo_capacity:                 0;

        can_attach_wagon:               sw_Kxxxx_attach_global;
        cargo_subtype_text:             sw_7x00_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_7x00_sound;
    }
    livery_override(ko_train_MUGUNGHWA_CAR) {
        default:                        sw_7x00_MUGUNGHWA_CAR_wagon;
        loading_speed:                  sw_MUGUNGHWA_CAR_loadingspeed;
        running_cost_factor:            sw_MUGUNGHWA_CAR_runningcost;
        cargo_capacity:                 sw_MUGUNGHWA_CAR_capacity;
        cargo_subtype_text:             sw_7x00_MUGUNGHWA_CAR_cargo_subtype_text;
    }
    livery_override(ko_train_SAEMAEUL_CAR) {
        default:                        sw_7x00_SAEMAEUL_CAR_wagon;
        loading_speed:                  sw_SAEMAEUL_CAR_loadingspeed;
        running_cost_factor:            sw_SAEMAEUL_CAR_runningcost;
        cargo_capacity:                 sw_SAEMAEUL_CAR_capacity;
        cargo_subtype_text:             sw_7x00_SAEMAEUL_CAR_cargo_subtype_text;
    }
    livery_override(ko_train_CAFE_CAR) {
        default:                        sw_7x00_CAFE_CAR_KWANKWANG_wagon;
        loading_speed:                  sw_CAFE_CAR_loadingspeed;
        running_cost_factor:            sw_CAFE_CAR_runningcost;
        cargo_capacity:                 sw_CAFE_CAR_capacity;
        cargo_subtype_text:             sw_7x00_CAFE_CAR_KWANKWANG_cargo_subtype_text;
    }
    livery_override(ko_train_GENERATOR_CAR) {
        default:                        sw_7x00_GENERATOR_CAR_KWANKWANG_wagon;
        cargo_subtype_text:             sw_7x00_GENERATOR_CAR_KWANKWANG_cargo_subtype_text;
        cargo_capacity:                 0;
        length:                         sw_GENERATOR_CAR_length;
    }
}