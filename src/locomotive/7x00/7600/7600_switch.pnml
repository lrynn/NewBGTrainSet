/*------------------------------------------------------------------------------
  7600 Switches
------------------------------------------------------------------------------*/

// Cargo subtype
switch(FEAT_TRAINS, SELF, sw_7600_cargo_subtype_text, cargo_subtype) {
    13: return string(STR_REFIT_LIVERY_7600_A_TRAIN);
    return string(STR_REFIT_LIVERY_7x00_CARGO);
}
switch(FEAT_TRAINS, SELF, sw_7600_loco, cargo_subtype) {
    13: set_7600_A_TRAIN;
    set_7600_CARGO;
}

// MUGUNGHWA_CAR
switch(FEAT_TRAINS, SELF, sw_7600_MUGUNGHWA_CAR_wagon, cargo_subtype) {
    13: sw_MUGUNGHWA_CAR_wagon_A_TRAIN;
    sw_MUGUNGHWA_CAR_wagon;
}
switch(FEAT_TRAINS, SELF, sw_7600_MUGUNGHWA_CAR_cargo_subtype_text, cargo_subtype) {
    13: return string(STR_REFIT_LIVERY_7600_A_TRAIN);
    sw_MUGUNGHWA_CAR_subtype_text;
}

// GENERATOR_CAR
switch(FEAT_TRAINS, SELF, sw_7600_GENERATOR_CAR_wagon, cargo_subtype) {
    13:    set_GENERATOR_CAR_A_TRAIN;
    sw_GENERATOR_CAR_wagon;
}
switch(FEAT_TRAINS, SELF, sw_7600_GENERATOR_CAR_cargo_subtype_text, cargo_subtype) {
    13: return string(STR_REFIT_LIVERY_7600_A_TRAIN);
    sw_GENERATOR_CAR_cargo_subtype_text;
}

// Sound
switch(FEAT_TRAINS, SELF, sw_7600_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/DEL7600start.wav");
    return CB_RESULT_NO_SOUND;
}