/*------------------------------------------------------------------------------
  7600 Graphics
------------------------------------------------------------------------------*/

// Cargo livery
spriteset(set_7600_CARGO_purchase, "./src/locomotive/7x00/7600/7600.png") {
    tmpl_purchase_common(0, 0)
}
spriteset(set_7600_CARGO, "./src/locomotive/7x00/7600/7600.png") {
    tmpl_standard(80, 0)
}

// A-train (Jeongseon Arirang)
spriteset(set_7600_A_TRAIN_purchase, "./src/locomotive/7x00/7600/7600.png") {
    tmpl_purchase_common(0, 30)
}
spriteset(set_7600_A_TRAIN, "./src/locomotive/7x00/7600/7600.png") {
    tmpl_standard(80, 30)
}

// Alias of purchase image
switch(FEAT_TRAINS, SELF, sw_7600_purchase, cargo_subtype) {
    set_7600_CARGO_purchase;
}
