/*--------------------------------------------------------------------
  CR400AF Switches
--------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_CR400AF_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_CR400AF_Z_NAME);
    return string(STR_REFIT_CR400AF_NAME);
}

switch(FEAT_TRAINS, SELF, sw_CR400AF_engineH, cargo_subtype) {
    1: return set_CR400AF_Z_engineH;
    return set_CR400AF_engineH;
}
switch(FEAT_TRAINS, SELF, sw_CR400AF_wagon, cargo_subtype) {
    1: return set_CR400AF_Z_wagon;
    return set_CR400AF_wagon;
}
switch(FEAT_TRAINS, SELF, sw_CR400AF_panto_wagon, cargo_subtype) {
    1: return set_CR400AF_Z_panto_wagon;
    return set_CR400AF_panto_wagon;
}
switch(FEAT_TRAINS, SELF, sw_CR400AF_panto_wagon_r, cargo_subtype) {
    1: return set_CR400AF_Z_panto_wagon_r;
    return set_CR400AF_panto_wagon_r;
}
switch(FEAT_TRAINS, SELF, sw_CR400AF_engineT, cargo_subtype) {
    1: return set_CR400AF_Z_engineT;
    return set_CR400AF_engineT;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_CR400AF_8car, position_in_vehid_chain % 8) {
    1:sw_CR400AF_wagon;
    2:sw_CR400AF_panto_wagon;
    3:sw_CR400AF_wagon;
    4:sw_CR400AF_wagon;
    5:sw_CR400AF_panto_wagon_r;
    6:sw_CR400AF_wagon;
    7:sw_CR400AF_engineT;
    sw_CR400AF_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_CR400AF_16car, position_in_vehid_chain % 16) {
    1:sw_CR400AF_wagon;
    2:sw_CR400AF_panto_wagon;
    3:sw_CR400AF_wagon;
    4:sw_CR400AF_wagon;
    5:sw_CR400AF_wagon;
    6:sw_CR400AF_wagon;
    7:sw_CR400AF_wagon;
    8:sw_CR400AF_wagon;
    9:sw_CR400AF_wagon;
    10:sw_CR400AF_panto_wagon;
    11:sw_CR400AF_wagon;
    12:sw_CR400AF_wagon;
    13:sw_CR400AF_wagon;
    14:sw_CR400AF_wagon;
    15:sw_CR400AF_engineT;
    sw_CR400AF_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_CR400AF_17car, position_in_vehid_chain % 17) {
    1:sw_CR400AF_wagon;
    2:sw_CR400AF_wagon;
    3:sw_CR400AF_wagon;
    4:sw_CR400AF_wagon;
    5:sw_CR400AF_wagon;
    6:sw_CR400AF_panto_wagon_r;
    7:sw_CR400AF_wagon;
    8:sw_CR400AF_wagon;
    9:sw_CR400AF_wagon;
    10:sw_CR400AF_wagon;
    11:sw_CR400AF_wagon;
    12:sw_CR400AF_wagon;
    13:sw_CR400AF_wagon;
    14:sw_CR400AF_panto_wagon_r;
    15:sw_CR400AF_wagon;
    16:sw_CR400AF_engineT;
    sw_CR400AF_engineH; //default
    }

switch (FEAT_TRAINS, SELF, sw_articulated_CR400AF_8car, extra_callback_info1) {
    1..7: CR400AF_8CAR;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_CR400AF_16car, extra_callback_info1) {
    1..15: CR400AF_16CAR;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_CR400AF_17car, extra_callback_info1) {
    1..16: CR400AF_17CAR;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }