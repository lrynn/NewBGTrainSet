/*------------------------------------------------------------------------------
    DAEGYEONG Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_DAEGYEONG, position_in_vehid_chain % 2) {
    1:set_DAEGYEONG_engineT;
    set_DAEGYEONG_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_DAEGYEONG_r, position_in_vehid_chain % 2) {
    1:set_DAEGYEONG_engineT;
    set_DAEGYEONG_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_DAEGYEONG_flipped, vehicle_is_flipped){
    0: sw_DAEGYEONG_r;
    sw_DAEGYEONG;
}
switch(FEAT_TRAINS, PARENT, sw_DAEGYEONG_reversed, vehicle_is_reversed){
    0: sw_DAEGYEONG;
    sw_DAEGYEONG_flipped;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_DAEGYEONG, extra_callback_info1) {
    1: DAEGYEONG;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DAEGYEONG_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1start.wav");
    return CB_RESULT_NO_SOUND;
}