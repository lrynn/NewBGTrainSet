/*------------------------------------------------------------------------------
    DAEJEON - LINE 1 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_DAEJEON_1, position_in_vehid_chain % 4) {
    1:set_DAEJEON_1_wagon_panto;
    2:set_DAEJEON_1_wagon_panto;
    3:set_DAEJEON_1_engineT;
    set_DAEJEON_1_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_DAEJEON_1_r, position_in_vehid_chain % 4) {
    1:set_DAEJEON_1_wagon_panto;
    2:set_DAEJEON_1_wagon_panto;
    3:set_DAEJEON_1_engineT;
    set_DAEJEON_1_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_DAEJEON_1_flipped, vehicle_is_flipped){
    0: sw_DAEJEON_1_r;
    sw_DAEJEON_1;
}
switch(FEAT_TRAINS, PARENT, sw_DAEJEON_1_reversed, vehicle_is_reversed){
    0: sw_DAEJEON_1;
    sw_DAEJEON_1_flipped;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_DAEJEON_1, extra_callback_info1) {
    1..3: DAEJEON_1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_DAEJEON_1_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1start.wav");
    return CB_RESULT_NO_SOUND;
}