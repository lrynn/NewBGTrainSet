// AREX_1K_NONSTOP_ORANGE
spriteset(set_AREX_1K_NONSTOP_ORANGE_engineH, "./src/metro/arex/AREX_1K_NONSTOP_ORANGE.png") {
    tmpl_standard(80, 0)
}
spriteset(set_AREX_1K_NONSTOP_ORANGE_wagon_panto, "./src/metro/arex/AREX_1K_NONSTOP_ORANGE.png") {
    tmpl_standard(80, 30)
}
spriteset(set_AREX_1K_NONSTOP_ORANGE_wagon, "./src/metro/arex/AREX_1K_NONSTOP_ORANGE.png") {
    tmpl_standard(80, 60)
}
spriteset(set_AREX_1K_NONSTOP_ORANGE_engineT, "./src/metro/arex/AREX_1K_NONSTOP_ORANGE.png") {
    tmpl_standard_r(80, 90)
}
spriteset(set_AREX_1K_NONSTOP_ORANGE_purchase, "./src/metro/arex/AREX_1K_NONSTOP_ORANGE.png") {
    tmpl_purchase_common(0, 0)
}

