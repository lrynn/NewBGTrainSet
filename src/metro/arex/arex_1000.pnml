/*------------------------------------------------------------------------------
    A'REX 1000 Series
------------------------------------------------------------------------------*/

#include "arex_1000_switch.pnml"

item(FEAT_TRAINS, AREX_1000, 8111) {
    property {
        // Common properties
        name:                           string(STR_AREX_1K_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              var_AREX_1000_INTRODUCTION;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_arex;

        // Spec
        speed:                          var_AREX_1000_SPEED;
        power:                          var_AREX_1000_POWER;
        weight:                         var_AREX_1000_WEIGHT;
        tractive_effort_coefficient:    0.4;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
    }
    graphics {
        default:                        sw_AREX_1000_reversed;
        articulated_part:               sw_articulated_AREX_1000;
        purchase:                       set_AREX_1K_NONSTOP_ORANGE_purchase;

        speed:                          var_AREX_1000_SPEED;
        cost_factor:                    var_AREX_1000_COST;
        running_cost_factor:            var_AREX_1000_RUNNINGCOST;
        cargo_capacity:                 var_AREX_1000_CAPACITY;
        purchase_cargo_capacity:        var_AREX_1000_CAPACITY;
        loading_speed:                  var_AREX_1000_LOADINGSPEED;

        cargo_subtype_text:             sw_AREX_1000_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_AREX_1000_sound;
    }
}