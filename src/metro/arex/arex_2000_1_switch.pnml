/*------------------------------------------------------------------------------
    A'REX 2000 Series 1, 2, 3 Gen. Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_AREX_2000_1, position_in_vehid_chain % 6) {
    1:set_AREX_2K_wagon;
    2:set_AREX_2K_wagon_panto;
    3:set_AREX_2K_wagon;
    4:set_AREX_2K_wagon_panto;
    5:set_AREX_2K_engineT;
    set_AREX_2K_engineH;
}
switch (FEAT_TRAINS, SELF, sw_AREX_2000_1_r, position_in_vehid_chain % 6) {
    1:set_AREX_2K_wagon_panto;
    2:set_AREX_2K_wagon;
    3:set_AREX_2K_wagon_panto;
    4:set_AREX_2K_wagon;
    5:set_AREX_2K_engineT;
    set_AREX_2K_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_AREX_2000_1_flipped, vehicle_is_flipped){
    0: sw_AREX_2000_1_r;
    sw_AREX_2000_1;
}
switch(FEAT_TRAINS, PARENT, sw_AREX_2000_1_reversed, vehicle_is_reversed){
    0: sw_AREX_2000_1;
    sw_AREX_2000_1_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_AREX_2000_1, extra_callback_info1) {
    1..5: AREX_2000_1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_AREX_2000_1_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1Kstart.wav");
    SOUND_EVENT_LOAD_UNLOAD: sound("sounds/osfx_20.wav");
    return CB_RESULT_NO_SOUND;
}