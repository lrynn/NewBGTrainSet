/*------------------------------------------------------------------------------
    A'REX 1000 Series Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_AREX_1000_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_AREX_1K_NONSTOP_ORANGE_NAME); // 2020년 도색
    return string(STR_REFIT_METRO_AREX_1K_NONSTOP_NAME);           // 기본
}

switch(FEAT_TRAINS, SELF, sw_AREX_1000_engineH, cargo_subtype) {
    1: return set_AREX_1K_NONSTOP_ORANGE_engineH;
    return set_AREX_1K_NONSTOP_engineH;
}
switch(FEAT_TRAINS, SELF, sw_AREX_1000_wagon_panto, cargo_subtype) {
    1: return set_AREX_1K_NONSTOP_ORANGE_wagon_panto;
    return set_AREX_1K_NONSTOP_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_AREX_1000_wagon, cargo_subtype) {
    1: return set_AREX_1K_NONSTOP_ORANGE_wagon;
    return set_AREX_1K_NONSTOP_wagon;
}
switch(FEAT_TRAINS, SELF, sw_AREX_1000_engineT, cargo_subtype) {
    1: return set_AREX_1K_NONSTOP_ORANGE_engineT;
    return set_AREX_1K_NONSTOP_engineT;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_AREX_1000, position_in_vehid_chain % 6) {
    1:sw_AREX_1000_wagon;
    2:sw_AREX_1000_wagon_panto;
    3:sw_AREX_1000_wagon;
    4:sw_AREX_1000_wagon_panto;
    5:sw_AREX_1000_engineT;
    sw_AREX_1000_engineH;
}
switch (FEAT_TRAINS, SELF, sw_AREX_1000_r, position_in_vehid_chain % 6) {
    1:sw_AREX_1000_wagon_panto;
    2:sw_AREX_1000_wagon;
    3:sw_AREX_1000_wagon_panto;
    4:sw_AREX_1000_wagon;
    5:sw_AREX_1000_engineT;
    sw_AREX_1000_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_AREX_1000_flipped, vehicle_is_flipped){
    0: sw_AREX_1000_r;
    sw_AREX_1000;
}
switch(FEAT_TRAINS, PARENT, sw_AREX_1000_reversed, vehicle_is_reversed){
    0: sw_AREX_1000;
    sw_AREX_1000_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_AREX_1000, extra_callback_info1) {
    1..5: AREX_1000;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_AREX_1000_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1Kstart.wav");
    SOUND_EVENT_LOAD_UNLOAD: sound("sounds/osfx_20.wav");
    return CB_RESULT_NO_SOUND;
}