/*------------------------------------------------------------------------------
    SEOUL - LINE 1
    10 CARS Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_10CAR, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_wagon;
    2:sw_SEOUL_1_wagon_panto;
    3:sw_SEOUL_1_wagon;
    4:sw_SEOUL_1_wagon_panto;
    5:sw_SEOUL_1_wagon;
    6:sw_SEOUL_1_wagon;
    7:sw_SEOUL_1_wagon;
    8:sw_SEOUL_1_wagon_panto;
    9:sw_SEOUL_1_engineT_r;
    sw_SEOUL_1_engineH; //default
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_10CAR_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_wagon_panto;
    2:sw_SEOUL_1_wagon;
    3:sw_SEOUL_1_wagon;
    4:sw_SEOUL_1_wagon;
    5:sw_SEOUL_1_wagon_panto;
    6:sw_SEOUL_1_wagon;
    7:sw_SEOUL_1_wagon_panto;
    8:sw_SEOUL_1_wagon;
    9:sw_SEOUL_1_engineT_r;
    sw_SEOUL_1_engineH; //default
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_10CAR_flipped, vehicle_is_flipped){
    0: sw_SEOUL_1_10CAR_r;
    sw_SEOUL_1_10CAR;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_1_10CAR_reversed, vehicle_is_reversed){
    0: sw_SEOUL_1_10CAR;
    sw_SEOUL_1_10CAR_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_1_10car, extra_callback_info1) {
    1..9: SEOUL_1_10car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}