/*------------------------------------------------------------------------------
    SEOUL - LINE 1
    10 CARS Switches - RESIST
------------------------------------------------------------------------------*/

// Cargo Subtypes

switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_cargo_subtype_text, cargo_subtype) {
    1:   return string(STR_REFIT_METRO_1K_RHEO_FIRST_1_NAME);          // KNR 1k Rheostatic first / 1st livery
    2:   return string(STR_REFIT_METRO_1K_RHEO_FIRST_2_NAME);          // KNR 1k Rheostatic first / 2nd livery
    3:   return string(STR_REFIT_METRO_1K_RHEO_SECOND_1_NAME);         // KNR 1k Rheostatic middle / 1st livery
    4:    return string(STR_REFIT_METRO_1K_RHEO_SECOND_2_NAME);         // KNR 1k Rheostatic middle / 2nd livery
    5:    return string(STR_REFIT_METRO_1K_RHEO_SECOND_3_NAME);         // Korail 1k Rheostatic middle / Current livery
    6:    return string(STR_REFIT_METRO_1K_RHEO_LAST_1_NAME);           // KNR 1k Rheostatic latter / 1st livery
    7:    return string(STR_REFIT_METRO_1K_RHEO_LAST_2_NAME);
    return string(STR_REFIT_METRO_1K_RHEO_FIRST_1_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_engineH, cargo_subtype) {
    1:   set_1K_RHEO_FIRST_1_engineH;
    2:   set_1K_RHEO_FIRST_2_engineH;
    3:   set_1K_RHEO_SECOND_1_engineH;
    4:    set_1K_RHEO_SECOND_2_engineH;
    5:    set_1K_RHEO_SECOND_3_engineH;
    6:    set_1K_RHEO_LAST_1_engineH;
    7:    set_1K_RHEO_LAST_2_engineH;
    set_1K_RHEO_FIRST_1_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_wagon, cargo_subtype) {
    1:   set_1K_RHEO_FIRST_1_wagon;
    2:   set_1K_RHEO_FIRST_2_wagon;
    3:   set_1K_RHEO_SECOND_1_wagon;
    4:    set_1K_RHEO_SECOND_2_wagon;
    5:    set_1K_RHEO_SECOND_3_wagon;
    6:    set_1K_RHEO_LAST_1_wagon;
    7:    set_1K_RHEO_LAST_2_wagon;
    set_1K_RHEO_FIRST_1_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_wagon_panto, cargo_subtype) {
    1:   set_1K_RHEO_FIRST_1_wagon_panto;
    2:   set_1K_RHEO_FIRST_2_wagon_panto;
    3:   set_1K_RHEO_SECOND_1_wagon_panto;
    4:    set_1K_RHEO_SECOND_2_wagon_panto;
    5:    set_1K_RHEO_SECOND_3_wagon_panto;
    6:    set_1K_RHEO_LAST_1_wagon_panto;
    7:    set_1K_RHEO_LAST_2_wagon_panto;
    set_1K_RHEO_FIRST_1_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_engineT_r, cargo_subtype) {
    1:   set_1K_RHEO_FIRST_1_engineT_r;
    2:   set_1K_RHEO_FIRST_2_engineT_r;
    3:   set_1K_RHEO_SECOND_1_engineT_r;
    4:    set_1K_RHEO_SECOND_2_engineT_r;
    5:    set_1K_RHEO_SECOND_3_engineT_r;
    6:    set_1K_RHEO_LAST_1_engineT_r;
    7:    set_1K_RHEO_LAST_2_engineT_r;
    set_1K_RHEO_FIRST_1_engineT_r;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_RESIST_wagon;
    2:sw_SEOUL_1_RESIST_wagon_panto;
    3:sw_SEOUL_1_RESIST_wagon;
    4:sw_SEOUL_1_RESIST_wagon;
    5:sw_SEOUL_1_RESIST_wagon_panto;
    6:sw_SEOUL_1_RESIST_wagon;
    7:sw_SEOUL_1_RESIST_wagon;
    8:sw_SEOUL_1_RESIST_wagon_panto;
    9:sw_SEOUL_1_RESIST_engineT_r;
    sw_SEOUL_1_RESIST_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_RESIST_wagon_panto;
    2:sw_SEOUL_1_RESIST_wagon;
    3:sw_SEOUL_1_RESIST_wagon;
    4:sw_SEOUL_1_RESIST_wagon_panto;
    5:sw_SEOUL_1_RESIST_wagon;
    6:sw_SEOUL_1_RESIST_wagon;
    7:sw_SEOUL_1_RESIST_wagon_panto;
    8:sw_SEOUL_1_RESIST_wagon;
    9:sw_SEOUL_1_RESIST_engineT_r;
    sw_SEOUL_1_RESIST_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_flipped, vehicle_is_flipped){
    0: sw_SEOUL_1_RESIST_r;
    sw_SEOUL_1_RESIST;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_1_RESIST_reversed, vehicle_is_reversed){
    0: sw_SEOUL_1_RESIST;
    sw_SEOUL_1_RESIST_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_1_RESIST, extra_callback_info1) {
    1..9: SEOUL_1_resist;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_RESIST_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/DCMOTERBASICstart.wav");
    return CB_RESULT_NO_SOUND;
}