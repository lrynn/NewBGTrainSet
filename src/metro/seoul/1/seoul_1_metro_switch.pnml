// Cargo Subtypes

switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_cargo_subtype_text, cargo_subtype) {
    15: return string(STR_REFIT_METRO_SMETRO_1K_RHEO_MODIFIED_NAME);
    return string(STR_REFIT_METRO_SMETRO_1K_RHEO_FIRST_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_engineH, cargo_subtype) {
    set_SMETRO_1K_VVVF_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_wagon, cargo_subtype) {
    set_SMETRO_1K_VVVF_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_wagon_panto, cargo_subtype) {
    set_SMETRO_1K_VVVF_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_engineT_r, cargo_subtype) {
    set_SMETRO_1K_VVVF_engineT_r;
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_engineH, cargo_subtype) {
    15: set_SMETRO_1K_RHEO_MODIFIED_engineH;
    set_SMETRO_1K_RHEO_FIRST_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_wagon, cargo_subtype) {
    15: set_SMETRO_1K_RHEO_MODIFIED_wagon;
    set_SMETRO_1K_RHEO_FIRST_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_wagon_panto, cargo_subtype) {
    15: set_SMETRO_1K_RHEO_MODIFIED_wagon_panto;
    set_SMETRO_1K_RHEO_FIRST_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_engineT_r, cargo_subtype) {
    15: set_SMETRO_1K_RHEO_MODIFIED_engineT_r;
    set_SMETRO_1K_RHEO_FIRST_engineT_r;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    2:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    3:sw_SEOUL_1_METRO_VVVF_wagon;
    4:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    5:sw_SEOUL_1_METRO_VVVF_wagon;
    6:sw_SEOUL_1_METRO_VVVF_wagon;
    7:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    8:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    9:sw_SEOUL_1_METRO_VVVF_engineT_r;
    sw_SEOUL_1_METRO_VVVF_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    2:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    3:sw_SEOUL_1_METRO_VVVF_wagon;
    4:sw_SEOUL_1_METRO_VVVF_wagon;
    5:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    6:sw_SEOUL_1_METRO_VVVF_wagon;
    7:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    8:sw_SEOUL_1_METRO_VVVF_wagon_panto;
    9:sw_SEOUL_1_METRO_VVVF_engineT_r;
    sw_SEOUL_1_METRO_VVVF_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_VVVF_flipped, vehicle_is_flipped){
    0: sw_SEOUL_1_METRO_VVVF_r;
    sw_SEOUL_1_METRO_VVVF;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_1_METRO_VVVF_reversed, vehicle_is_reversed){
    0: sw_SEOUL_1_METRO_VVVF;
    sw_SEOUL_1_METRO_VVVF_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_METRO_RESIST_wagon;
    2:sw_SEOUL_1_METRO_RESIST_wagon_panto;
