    9:sw_SEOUL_1_METRO_RESIST_engineT_r;
    sw_SEOUL_1_METRO_RESIST_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_flipped, vehicle_is_flipped){
    0: sw_SEOUL_1_METRO_RESIST_r;
    sw_SEOUL_1_METRO_RESIST;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_1_METRO_RESIST_reversed, vehicle_is_reversed){
    0: sw_SEOUL_1_METRO_RESIST;
    sw_SEOUL_1_METRO_RESIST_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_1_METRO_VVVF, extra_callback_info1) {
    1..9: SEOUL_1_metro_vvvf;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_1_METRO_RESIST, extra_callback_info1) {
