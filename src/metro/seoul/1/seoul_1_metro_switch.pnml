switch (FEAT_TRAINS, SELF, sw_SEOUL_1_METRO_RESIST_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_1_METRO_RESIST_wagon_panto;
    2:sw_SEOUL_1_METRO_RESIST_wagon;
    3:sw_SEOUL_1_METRO_RESIST_wagon;
    4:sw_SEOUL_1_METRO_RESIST_wagon_panto;
