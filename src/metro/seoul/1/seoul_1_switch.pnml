// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_sound_start, cargo_subtype) {
    1: sound("sounds/TOSHIBAGTOKStart.wav");
    3: sound("sounds/TOSHIBAGTOKStart.wav");
    2: sound("sounds/TOSHIBAIGBTKStart.wav");
    4..6: sound("sounds/TOSHIBAIGBTKStart.wav");
    22..23: sound("sounds/HYUNDAIROTEMPMSMstart.wav");
    24: sound("sounds/WOOJIN_IGBT_2start.wav");
    return CB_RESULT_NO_SOUND;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_sound, extra_callback_info1) {
    SOUND_EVENT_START: sw_SEOUL_1_sound_start;
    return CB_RESULT_NO_SOUND;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_1_shuttle_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TOSHIBAIGBTKStart.wav");
    return CB_RESULT_NO_SOUND;
}