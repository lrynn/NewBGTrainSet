/*------------------------------------------------------------------------------
    SEOUL - LINE 8 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_9, position_in_vehid_chain % 6) {
    1:set_SEOUL_9_1_wagon_panto;
    2:set_SEOUL_9_1_wagon;
    3:set_SEOUL_9_1_wagon;
    4:set_SEOUL_9_1_wagon_panto;
    5:set_SEOUL_9_1_engineT;
    set_SEOUL_9_1_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_9_r, position_in_vehid_chain % 6) {
    1:set_SEOUL_9_1_wagon_panto;
    2:set_SEOUL_9_1_wagon;
    3:set_SEOUL_9_1_wagon;
    4:set_SEOUL_9_1_wagon_panto;
    5:set_SEOUL_9_1_engineT;
    set_SEOUL_9_1_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_9_flipped, vehicle_is_flipped){
    0: sw_SEOUL_9_r;
    sw_SEOUL_9;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_9_reversed, vehicle_is_reversed){
    0: sw_SEOUL_9;
    sw_SEOUL_9_flipped;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_9, extra_callback_info1) {
    1..5: SEOUL_9;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
// switch(FEAT_TRAINS, SELF, sw_SEOUL_9_sound_by_supplier, cargo_subtype) {
//     1: return sound("sounds/ALSTOMGTOstart.wav");
//     2: return sound("sounds/TOSHIBAIGBTKStart.wav");
//     3: return sound("sounds/TOSHIBAIGBTPMSMstart.wav");
//     return sound("sounds/ALSTOMGTOstart.wav");
// }
switch(FEAT_TRAINS, SELF, sw_SEOUL_9_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/HYUNDAIROTEMIGBTIPM1start.wav");
    return CB_RESULT_NO_SOUND;
}