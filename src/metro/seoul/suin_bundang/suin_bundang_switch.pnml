/*------------------------------------------------------------------------------
    SUIN-BUNDANG LINE Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_SUIN_BUNDANG_1_1_NAME);
    2: return string(STR_REFIT_METRO_SUIN_BUNDANG_1_2_NAME);
    4: return string(STR_REFIT_METRO_SUIN_BUNDANG_2_NAME);
    5: return string(STR_REFIT_METRO_SUIN_BUNDANG_3_NAME);
    9: return string(STR_REFIT_METRO_SUIN_BUNDANG_4_NAME);
    return string(STR_REFIT_METRO_SUIN_BUNDANG_1_1_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_engineH, cargo_subtype) {
    1: return set_SUIN_BUNDANG_1_1_engineH;
    2: return set_SUIN_BUNDANG_1_2_engineH;
    4: return set_SUIN_BUNDANG_2_engineH;
    5: return set_SUIN_BUNDANG_3_engineH;
    9: return set_SUIN_BUNDANG_4_engineH;
    return set_SUIN_BUNDANG_1_1_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_engineT, cargo_subtype) {
    1: return set_SUIN_BUNDANG_1_1_engineT;
    2: return set_SUIN_BUNDANG_1_2_engineT;
    4: return set_SUIN_BUNDANG_2_engineT;
    5: return set_SUIN_BUNDANG_3_engineT;
    9: return set_SUIN_BUNDANG_4_engineT;
    return set_SUIN_BUNDANG_1_1_engineT;
}
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_wagon, cargo_subtype) {
    1: return set_SUIN_BUNDANG_1_1_wagon;
    2: return set_SUIN_BUNDANG_1_2_wagon;
    4: return set_SUIN_BUNDANG_2_wagon;
    5: return set_SUIN_BUNDANG_3_wagon;
    9: return set_SUIN_BUNDANG_4_wagon;
    return set_SUIN_BUNDANG_1_1_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_wagon_panto, cargo_subtype) {
    1: return set_SUIN_BUNDANG_1_1_wagon_panto;
    2: return set_SUIN_BUNDANG_1_2_wagon_panto;
    4: return set_SUIN_BUNDANG_2_wagon_panto;
    5: return set_SUIN_BUNDANG_3_wagon_panto;
    9: return set_SUIN_BUNDANG_4_wagon_panto;
    return set_SUIN_BUNDANG_1_1_wagon_panto;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SUIN_BUNDANG, position_in_vehid_chain % 6) {
    1:sw_SUIN_BUNDANG_wagon;
    2:sw_SUIN_BUNDANG_wagon_panto;
    3:sw_SUIN_BUNDANG_wagon;
    4:sw_SUIN_BUNDANG_wagon_panto;
    5:sw_SUIN_BUNDANG_engineT;
    sw_SUIN_BUNDANG_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_r, position_in_vehid_chain % 6) {
    1:sw_SUIN_BUNDANG_wagon_panto;
    2:sw_SUIN_BUNDANG_wagon;
    3:sw_SUIN_BUNDANG_wagon_panto;
    4:sw_SUIN_BUNDANG_wagon;
    5:sw_SUIN_BUNDANG_engineT;
    sw_SUIN_BUNDANG_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_flipped, vehicle_is_flipped){
    0: sw_SUIN_BUNDANG_r;
    sw_SUIN_BUNDANG;
}
switch(FEAT_TRAINS, PARENT, sw_SUIN_BUNDANG_reversed, vehicle_is_reversed){
    0: sw_SUIN_BUNDANG;
    sw_SUIN_BUNDANG_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SUIN_BUNDANG, extra_callback_info1) {
    1..5: SUIN_BUNDANG;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_sound_by_supplier, cargo_subtype) {
    1..4: return sound("sounds/TOSHIBAGTOKStart.wav");
    5..8: return sound("sounds/TOSHIBAIGBTKStart.wav");
    9: return sound("sounds/HYUNDAIROTEMPMSMstart.wav");
    return sound("sounds/TOSHIBAGTOKStart.wav");
}
switch(FEAT_TRAINS, SELF, sw_SUIN_BUNDANG_sound, extra_callback_info1) {
    SOUND_EVENT_START: sw_SUIN_BUNDANG_sound_by_supplier;
    return CB_RESULT_NO_SOUND;
}