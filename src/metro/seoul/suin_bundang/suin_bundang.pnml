/*------------------------------------------------------------------------------
    Suin-Bundang Line
------------------------------------------------------------------------------*/

// Graphics
#include "suin_bundang_graphic.pnml"

// Switch
#include "suin_bundang_switch.pnml"

item(FEAT_TRAINS, SUIN_BUNDANG, 3516) {
    property {
        // Common properties
        name:                           string(STR_SUIN_BUNDANG_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1993, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;

        // Spec
        power:                          var_SUIN_BUNDANG_POWER;
        weight:                         var_SUIN_BUNDANG_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT);
    }
    graphics {
        default:                        sw_SUIN_BUNDANG_reversed;
        articulated_part:               sw_articulated_SUIN_BUNDANG;
        purchase:                       set_SUIN_BUNDANG_purchase;

        speed:                          var_SUIN_BUNDANG_SPEED;
        cost_factor:                    var_SUIN_BUNDANG_COST;
        running_cost_factor:            var_SUIN_BUNDANG_RUNNINGCOST;
        cargo_capacity:                 var_METRO_CAPACITY;
        purchase_cargo_capacity:        var_METRO_CAPACITY;
        loading_speed:                  sw_METRO_loadingspeed;

        can_attach_wagon:               sw_METRO_attach_global;
        cargo_subtype_text:             sw_SUIN_BUNDANG_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_SUIN_BUNDANG_sound;
    }
}