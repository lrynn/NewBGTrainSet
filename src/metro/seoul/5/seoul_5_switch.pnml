/*------------------------------------------------------------------------------
    SEOUL - LINE 5 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_LINE_5_1_NAME);
    3: return string(STR_REFIT_METRO_LINE_5_3_NAME);
    4: return string(STR_REFIT_METRO_LINE_5_4_NAME);
    5: return string(STR_REFIT_METRO_LINE_5_5_NAME);
    return string(STR_REFIT_METRO_LINE_5_1_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_5_engineH, cargo_subtype) {
    1: return set_SMETRO_5K_1ST_2ND_engineH;
    3: return set_SMETRO_5K_3RD_engineH;
    // 4: return set_SMETRO_5K_4TH_engineH;
    5: return set_SMETRO_5K_5TH_engineH;
    return set_SMETRO_5K_1ST_2ND_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_wagon, cargo_subtype) {
    1: return set_SMETRO_5K_1ST_2ND_wagon;
    3: return set_SMETRO_5K_3RD_wagon;
    // 4: return set_SMETRO_5K_4TH_wagon;
    5: return set_SMETRO_5K_5TH_wagon;
    return set_SMETRO_5K_1ST_2ND_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_wagon_panto, cargo_subtype) {
    1: return set_SMETRO_5K_1ST_2ND_wagon_panto;
    3: return set_SMETRO_5K_3RD_wagon_panto;
    // 4: return set_SMETRO_5K_4TH_wagon_panto;
    5: return set_SMETRO_5K_5TH_wagon_panto;
    return set_SMETRO_5K_1ST_2ND_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_engineT, cargo_subtype) {
    1: return set_SMETRO_5K_1ST_2ND_engineT;
    3: return set_SMETRO_5K_3RD_engineT;
    // 4: return set_SMETRO_5K_4TH_engineT;
    5: return set_SMETRO_5K_5TH_engineT;
    return set_SMETRO_5K_1ST_2ND_engineT;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_5, position_in_vehid_chain % 8) {
    1:sw_SEOUL_5_wagon_panto;
    2:sw_SEOUL_5_wagon;
    3:sw_SEOUL_5_wagon;
    4:sw_SEOUL_5_wagon;
    5:sw_SEOUL_5_wagon_panto;
    6:sw_SEOUL_5_wagon;
    7:sw_SEOUL_5_engineT;
    sw_SEOUL_5_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_5_r, position_in_vehid_chain % 8) {
    1:sw_SEOUL_5_wagon;
    2:sw_SEOUL_5_wagon_panto;
    3:sw_SEOUL_5_wagon;
    4:sw_SEOUL_5_wagon;
    5:sw_SEOUL_5_wagon;
    6:sw_SEOUL_5_wagon_panto;
    7:sw_SEOUL_5_engineT;
    sw_SEOUL_5_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_flipped, vehicle_is_flipped){
    0: sw_SEOUL_5_r;
    sw_SEOUL_5;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_5_reversed, vehicle_is_reversed){
    0: sw_SEOUL_5;
    sw_SEOUL_5_flipped;
}

// Livery for 4TH Edition
switch (FEAT_TRAINS, SELF, sw_SEOUL_5_4, position_in_vehid_chain % 8) {
    1:set_SMETRO_5K_4TH_wagon_panto_A;
    2:set_SMETRO_5K_4TH_wagon_B;
    3:set_SMETRO_5K_4TH_wagon_A;
    4:set_SMETRO_5K_4TH_wagon_B;
    5:set_SMETRO_5K_4TH_wagon_panto_A;
    6:set_SMETRO_5K_4TH_wagon_B;
    7:set_SMETRO_5K_4TH_engineT;
    set_SMETRO_5K_4TH_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_5_4_r, position_in_vehid_chain % 8) {
    1:set_SMETRO_5K_4TH_wagon_A;
    2:set_SMETRO_5K_4TH_wagon_panto_B;
    3:set_SMETRO_5K_4TH_wagon_A;
    4:set_SMETRO_5K_4TH_wagon_B;
    5:set_SMETRO_5K_4TH_wagon_A;
    6:set_SMETRO_5K_4TH_wagon_panto_B;
    7:set_SMETRO_5K_4TH_engineT;
    set_SMETRO_5K_4TH_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_4_flipped, vehicle_is_flipped){
    0: sw_SEOUL_5_4_r;
    sw_SEOUL_5_4;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_5_4_reversed, vehicle_is_reversed){
    0: sw_SEOUL_5_4;
    sw_SEOUL_5_4_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_5, extra_callback_info1) {
    1..7: SEOUL_5;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_5_COMBINED_reversed, cargo_subtype) {
    4: return sw_SEOUL_5_4_reversed;
    return sw_SEOUL_5_reversed;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_sound_by_supplier, cargo_subtype) {
    1: return sound("sounds/ABBGTOstart.wav");
    3: return sound("sounds/HYUNDAIROTEMIGBTIPM2start.wav");
    4: return sound("sounds/TOSHIBAIGBTPMSMstart.wav");
    5: return sound("sounds/DAWONSYSIGBT2start.wav");
    return sound("sounds/ABBGTOstart.wav");
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_5_sound, extra_callback_info1) {
    SOUND_EVENT_START: sw_SEOUL_5_sound_by_supplier;
    return CB_RESULT_NO_SOUND;
}