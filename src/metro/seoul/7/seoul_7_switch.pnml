/*------------------------------------------------------------------------------
    SEOUL - LINE 7 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_LINE_7_1_NAME);
    2: return string(STR_REFIT_METRO_LINE_7_2_NAME);
    3: return string(STR_REFIT_METRO_LINE_7_3_NAME);
    4: return string(STR_REFIT_METRO_LINE_7_4_NAME);
    5: return string(STR_REFIT_METRO_LINE_7_5_NAME);
    return string(STR_REFIT_METRO_LINE_7_1_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_7_engineH, cargo_subtype) {
    1..2: return set_SMETRO_7K_1ST_2ND_engineH;
    3: return set_SMETRO_7K_3RD_engineH;
    4: return set_SMETRO_7K_4TH_engineH;
    return set_SMETRO_7K_1ST_2ND_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_wagon, cargo_subtype) {
    1..2: return set_SMETRO_7K_1ST_2ND_wagon;
    3: return set_SMETRO_7K_3RD_wagon;
    4: return set_SMETRO_7K_4TH_wagon;
    return set_SMETRO_7K_1ST_2ND_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_wagon_panto, cargo_subtype) {
    1..2: return set_SMETRO_7K_1ST_2ND_wagon_panto;
    3: return set_SMETRO_7K_3RD_wagon_panto;
    4: return set_SMETRO_7K_4TH_wagon_panto;
    return set_SMETRO_7K_1ST_2ND_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_engineT, cargo_subtype) {
    1..2: return set_SMETRO_7K_1ST_2ND_engineT;
    3: return set_SMETRO_7K_3RD_engineT;
    4: return set_SMETRO_7K_4TH_engineT;
    return set_SMETRO_7K_1ST_2ND_engineT;
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_7, position_in_vehid_chain % 8) {
    1:sw_SEOUL_7_wagon_panto;
    2:sw_SEOUL_7_wagon;
    3:sw_SEOUL_7_wagon;
    4:sw_SEOUL_7_wagon;
    5:sw_SEOUL_7_wagon_panto;
    6:sw_SEOUL_7_wagon;
    7:sw_SEOUL_7_engineT;
    sw_SEOUL_7_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_7_r, position_in_vehid_chain % 8) {
    1:sw_SEOUL_7_wagon;
    2:sw_SEOUL_7_wagon_panto;
    3:sw_SEOUL_7_wagon;
    4:sw_SEOUL_7_wagon;
    5:sw_SEOUL_7_wagon;
    6:sw_SEOUL_7_wagon_panto;
    7:sw_SEOUL_7_engineT;
    sw_SEOUL_7_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_flipped, vehicle_is_flipped){
    0: sw_SEOUL_7_r;
    sw_SEOUL_7;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_7_reversed, vehicle_is_reversed){
    0: sw_SEOUL_7;
    sw_SEOUL_7_flipped;
}

// Livery for 5TH Edition
switch (FEAT_TRAINS, SELF, sw_SEOUL_7_5, position_in_vehid_chain % 8) {
    1:set_SMETRO_7K_5TH_wagon_panto_A;
    2:set_SMETRO_7K_5TH_wagon_B;
    3:set_SMETRO_7K_5TH_wagon_A;
    4:set_SMETRO_7K_5TH_wagon_B;
    5:set_SMETRO_7K_5TH_wagon_panto_A;
    6:set_SMETRO_7K_5TH_wagon_B;
    7:set_SMETRO_7K_5TH_engineT;
    set_SMETRO_7K_5TH_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_7_5_r, position_in_vehid_chain % 8) {
    1:set_SMETRO_7K_5TH_wagon_A;
    2:set_SMETRO_7K_5TH_wagon_panto_B;
    3:set_SMETRO_7K_5TH_wagon_A;
    4:set_SMETRO_7K_5TH_wagon_B;
    5:set_SMETRO_7K_5TH_wagon_A;
    6:set_SMETRO_7K_5TH_wagon_panto_B;
    7:set_SMETRO_7K_5TH_engineT;
    set_SMETRO_7K_5TH_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_5_flipped, vehicle_is_flipped){
    0: sw_SEOUL_7_5_r;
    sw_SEOUL_7_5;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_7_5_reversed, vehicle_is_reversed){
    0: sw_SEOUL_7_5;
    sw_SEOUL_7_5_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_7, extra_callback_info1) {
    1..7: SEOUL_7;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_7_COMBINED_reversed, cargo_subtype) {
    1..4: return sw_SEOUL_7_reversed;
    5: return sw_SEOUL_7_5_reversed;
    return sw_SEOUL_7_reversed;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_sound_by_supplier, cargo_subtype) {
    1: return sound("sounds/ALSTOMGTOstart.wav");
    2: return sound("sounds/TOSHIBAIGBTKStart.wav");
    3..4: return sound("sounds/DAWONSYSIGBTstart.wav");
    5: return sound("sounds/TOSHIBAIGBTPMSMstart.wav");
    return sound("sounds/ALSTOMGTOstart.wav");
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_7_sound, extra_callback_info1) {
    SOUND_EVENT_START: sw_SEOUL_7_sound_by_supplier;
    return CB_RESULT_NO_SOUND;
}