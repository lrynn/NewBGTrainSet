/*------------------------------------------------------------------------------
    SEOUL - LINE 2
    Switches - CHOPPER
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_2_MELCO, position_in_vehid_chain % 10) {
    1:set_2K_MELCO_wagon_panto;
    2:set_2K_MELCO_wagon;
    3:set_2K_MELCO_wagon;
    4:set_2K_MELCO_wagon_panto;
    5:set_2K_MELCO_wagon;
    6:set_2K_MELCO_wagon_panto;
    7:set_2K_MELCO_wagon;
    8:set_2K_MELCO_wagon_panto;
    9:set_2K_MELCO_engineT_r;
    set_2K_MELCO_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_2_MELCO_r, position_in_vehid_chain % 10) {
    1:set_2K_MELCO_wagon_panto;
    2:set_2K_MELCO_wagon;
    3:set_2K_MELCO_wagon_panto;
    4:set_2K_MELCO_wagon;
    5:set_2K_MELCO_wagon_panto;
    6:set_2K_MELCO_wagon;
    7:set_2K_MELCO_wagon;
    8:set_2K_MELCO_wagon_panto;
    9:set_2K_MELCO_engineT_r;
    set_2K_MELCO_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_2_MELCO_flipped, vehicle_is_flipped){
    0: sw_SEOUL_2_MELCO_r;
    sw_SEOUL_2_MELCO;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_2_MELCO_reversed, vehicle_is_reversed){
    0: sw_SEOUL_2_MELCO;
    sw_SEOUL_2_MELCO_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_2_CHOPPER, position_in_vehid_chain % 10) {
    1:set_2K_CHOPPER_wagon_panto;
    2:set_2K_CHOPPER_wagon;
    3:set_2K_CHOPPER_wagon;
    4:set_2K_CHOPPER_wagon_panto;
    5:set_2K_CHOPPER_wagon;
    6:set_2K_CHOPPER_wagon_panto;
    7:set_2K_CHOPPER_wagon;
    8:set_2K_CHOPPER_wagon_panto;
    9:set_2K_CHOPPER_engineT_r;
    set_2K_CHOPPER_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_2_CHOPPER_r, position_in_vehid_chain % 10) {
    1:set_2K_CHOPPER_wagon_panto;
    2:set_2K_CHOPPER_wagon;
    3:set_2K_CHOPPER_wagon_panto;
    4:set_2K_CHOPPER_wagon;
    5:set_2K_CHOPPER_wagon_panto;
    6:set_2K_CHOPPER_wagon;
    7:set_2K_CHOPPER_wagon;
    8:set_2K_CHOPPER_wagon_panto;
    9:set_2K_CHOPPER_engineT_r;
    set_2K_CHOPPER_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_2_CHOPPER_flipped, vehicle_is_flipped){
    0: sw_SEOUL_2_CHOPPER_r;
    sw_SEOUL_2_CHOPPER;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_2_CHOPPER_reversed, vehicle_is_reversed){
    0: sw_SEOUL_2_CHOPPER;
    sw_SEOUL_2_CHOPPER_flipped;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_2_MELCO, extra_callback_info1) {
    1..9: SEOUL_2_melco;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_2_CHOPPER, extra_callback_info1) {
    1..9: SEOUL_2_chopper;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_2_chopper_sound_melco, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/MITSUBISHICHOPPER1start.wav");
    return CB_RESULT_NO_SOUND;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_2_chopper_sound_gec, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/GECCHOPPERstart.wav");
    return CB_RESULT_NO_SOUND;
}