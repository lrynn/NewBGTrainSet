/*------------------------------------------------------------------------------
    SEOUL - LINE 2
    VVVF
------------------------------------------------------------------------------*/

#include "seoul_2_vvvf_switch.pnml"

// Item

// 4 cars
item(FEAT_TRAINS, SEOUL_2_vvvf_4car, 3224) {
    property {
        // Common properties
        name:                           string(STR_SEOUL_2_4CAR_VVVF_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2005, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  group_seoul_2;

        // Spec
        power:                          var_METRO_4CAR_POWER;
        weight:                         var_METRO_4CAR_WEIGHT;
        tractive_effort_coefficient:    0.25;
        air_drag_coefficient:           0.01;

        // Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;

        // Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];

        // Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;

        // Flags
        ai_special_flag:                AI_FLAG_PASSENGER;
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
    }
    graphics {
        default:                        sw_SEOUL_2_VVVF_4car_reversed;
        articulated_part:               sw_articulated_SEOUL_2_VVVF_4car;
        purchase:                       set_2K_VVVF_4TH_purchase;

        speed:                          var_METRO_SPEED;
        cost_factor:                    var_METRO_4CAR_COST;
        running_cost_factor:            var_METRO_4CAR_RUNNINGCOST;
        cargo_capacity:                 var_METRO_CAPACITY;
        purchase_cargo_capacity:        var_METRO_CAPACITY;
        loading_speed:                  sw_METRO_loadingspeed;

        cargo_subtype_text:             sw_SEOUL_2_VVVF_4car_cargo_subtype_text;
        additional_text:                string(STR_REFIT_ADDITIONAL_ABLE);

        sound_effect:                   sw_SEOUL_2_vvvf_sound;
    }
}

