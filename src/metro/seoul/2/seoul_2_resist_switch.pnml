    3:set_2K_RHEO_MODIFIED_engineT_r;
    set_2K_RHEO_MODIFIED_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_2_RESIST_4car_flipped, vehicle_is_flipped){
    0: sw_SEOUL_2_RESIST_4car_r;
    sw_SEOUL_2_RESIST_4car;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_2_RESIST_4car_reversed, vehicle_is_reversed){
    0: sw_SEOUL_2_RESIST_4car;
    sw_SEOUL_2_RESIST_4car_flipped;
}

