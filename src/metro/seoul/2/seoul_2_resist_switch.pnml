// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_2_RESIST_4car, position_in_vehid_chain % 10) {
    1:set_2K_RHEO_MODIFIED_wagon_panto;
    2:set_2K_RHEO_MODIFIED_wagon_panto;
    3:set_2K_RHEO_MODIFIED_engineT_r;
    set_2K_RHEO_MODIFIED_engineH; //default
}
