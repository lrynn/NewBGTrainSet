/*------------------------------------------------------------------------------
  Seoul - Line 2 Switches
------------------------------------------------------------------------------*/

// Cargo Subtype Names

// chopper : 광폭형
// MELCO   : 직각형

switch(FEAT_TRAINS, SELF, sw_SEOUL_2_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_2K_RHEO_MODIFIED_NAME);
    2: return string(STR_REFIT_METRO_2K_MELCO_NAME);
    3: return string(STR_REFIT_METRO_2K_CHOPPER_NAME);
    4: return string(STR_REFIT_METRO_2K_VVVF_1ST_NAME);
    5: return string(STR_REFIT_METRO_2K_VVVF_2ND_NAME);
    6: return string(STR_REFIT_METRO_2K_VVVF_3RD_NAME);
    7: return string(STR_REFIT_METRO_2K_VVVF_4TH_NAME);
    return string(STR_REFIT_METRO_2K_VVVF_4TH_NAME);
}


// Cars

switch(FEAT_TRAINS, SELF, sw_SEOUL_2_engineH, cargo_subtype) {
    1: set_2K_RHEO_MODIFIED_engineH;
    2: set_2K_MELCO_engineH;
    3: set_2K_CHOPPER_engineH;
    4: set_2K_VVVF_1ST_engineH;
    5: set_2K_VVVF_2ND_engineH;
    6: set_2K_VVVF_3RD_engineH;
    7: set_2K_VVVF_4TH_engineH;
}
