/*------------------------------------------------------------------------------
    SEOUL - LINE 6 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_6, position_in_vehid_chain % 8) {
    1:set_SEOUL_6_wagon_panto;
    2:set_SEOUL_6_wagon;
    3:set_SEOUL_6_wagon;
    4:set_SEOUL_6_wagon;
    5:set_SEOUL_6_wagon_panto;
    6:set_SEOUL_6_wagon;
    7:set_SEOUL_6_engineT;
    set_SEOUL_6_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_6_r, position_in_vehid_chain % 8) {
    1:set_SEOUL_6_wagon;
    2:set_SEOUL_6_wagon_panto;
    3:set_SEOUL_6_wagon;
    4:set_SEOUL_6_wagon;
    5:set_SEOUL_6_wagon;
    6:set_SEOUL_6_wagon_panto;
    7:set_SEOUL_6_engineT;
    set_SEOUL_6_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_6_flipped, vehicle_is_flipped){
    0: sw_SEOUL_6_r;
    sw_SEOUL_6;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_6_reversed, vehicle_is_reversed){
    0: sw_SEOUL_6;
    sw_SEOUL_6_flipped;
}

// set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_6, extra_callback_info1) {
    1..7: SEOUL_6;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_6_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/MITSUBISHIigbtstart.wav");
    return CB_RESULT_NO_SOUND;
}