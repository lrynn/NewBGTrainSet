/*------------------------------------------------------------------------------
    SEOUL - LINE 3
    Korail Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_3K_VVVF_1ST_1_NAME);
    2: return string(STR_REFIT_METRO_3K_VVVF_1ST_2_NAME);
    3: return string(STR_REFIT_METRO_LINE_3_2022_NAME);
    4: return string(STR_REFIT_METRO_LINE_3_2022_W_NAME);
    return string(STR_REFIT_METRO_3K_VVVF_1ST_1_NAME);
}

switch(FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_engineH, cargo_subtype) {
    1: return set_SEOUL_3_KORAIL_VVVF_1ST_1_engineH;
    2: return set_SEOUL_3_KORAIL_VVVF_1ST_2_engineH;
    3: return set_SEOUL_3_KORAIL_2022_engineH;
    4: return set_SEOUL_3_KORAIL_2022_W_engineH;
    return set_SEOUL_3_KORAIL_VVVF_1ST_1_engineH;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_wagon, cargo_subtype) {
    1: return set_SEOUL_3_KORAIL_VVVF_1ST_1_wagon;
    2: return set_SEOUL_3_KORAIL_VVVF_1ST_2_wagon;
    3: return set_SEOUL_3_KORAIL_2022_wagon;
    4: return set_SEOUL_3_KORAIL_2022_W_wagon;
    return set_SEOUL_3_KORAIL_VVVF_1ST_1_wagon;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_wagon_panto, cargo_subtype) {
    1: return set_SEOUL_3_KORAIL_VVVF_1ST_1_wagon_panto;
    2: return set_SEOUL_3_KORAIL_VVVF_1ST_2_wagon_panto;
    3: return set_SEOUL_3_KORAIL_2022_wagon_panto;
    4: return set_SEOUL_3_KORAIL_2022_W_wagon_panto;
    return set_SEOUL_3_KORAIL_VVVF_1ST_1_wagon_panto;
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_engineT, cargo_subtype) {
    1: return set_SEOUL_3_KORAIL_VVVF_1ST_1_engineT;
    2: return set_SEOUL_3_KORAIL_VVVF_1ST_2_engineT;
    3: return set_SEOUL_3_KORAIL_2022_engineT;
    4: return set_SEOUL_3_KORAIL_2022_W_engineT;
    return set_SEOUL_3_KORAIL_VVVF_1ST_1_engineT;
}


// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_korail_1, position_in_vehid_chain % 10) {
    1:sw_SEOUL_3_KORAIL_wagon_panto;
    2:sw_SEOUL_3_KORAIL_wagon_panto;
    3:sw_SEOUL_3_KORAIL_wagon;
    4:sw_SEOUL_3_KORAIL_wagon_panto;
    5:sw_SEOUL_3_KORAIL_wagon;
    6:sw_SEOUL_3_KORAIL_wagon;
    7:sw_SEOUL_3_KORAIL_wagon_panto;
    8:sw_SEOUL_3_KORAIL_wagon_panto;
    9:sw_SEOUL_3_KORAIL_engineT;
    sw_SEOUL_3_KORAIL_engineH;
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_korail_1_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_3_KORAIL_wagon_panto;
    2:sw_SEOUL_3_KORAIL_wagon_panto;
    3:sw_SEOUL_3_KORAIL_wagon;
    4:sw_SEOUL_3_KORAIL_wagon;
    5:sw_SEOUL_3_KORAIL_wagon_panto;
    6:sw_SEOUL_3_KORAIL_wagon;
    7:sw_SEOUL_3_KORAIL_wagon_panto;
    8:sw_SEOUL_3_KORAIL_wagon_panto;
    9:sw_SEOUL_3_KORAIL_engineT;
    sw_SEOUL_3_KORAIL_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_korail_1_flipped, vehicle_is_flipped){
    0: sw_SEOUL_3_korail_1_r;
    sw_SEOUL_3_korail_1;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_3_korail_1_reversed, vehicle_is_reversed){
    0: sw_SEOUL_3_korail_1;
    sw_SEOUL_3_korail_1_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_3_korail_2, position_in_vehid_chain % 10) {
    1:sw_SEOUL_3_KORAIL_wagon;
    2:sw_SEOUL_3_KORAIL_wagon_panto;
    3:sw_SEOUL_3_KORAIL_wagon;
    4:sw_SEOUL_3_KORAIL_wagon_panto;
    5:sw_SEOUL_3_KORAIL_wagon;
    6:sw_SEOUL_3_KORAIL_wagon;
    7:sw_SEOUL_3_KORAIL_wagon;
    8:sw_SEOUL_3_KORAIL_wagon_panto;
    9:sw_SEOUL_3_KORAIL_engineT;
    sw_SEOUL_3_KORAIL_engineH;
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_korail_2_r, position_in_vehid_chain % 10) {
    1:sw_SEOUL_3_KORAIL_wagon_panto;
    2:sw_SEOUL_3_KORAIL_wagon;
    3:sw_SEOUL_3_KORAIL_wagon;
    4:sw_SEOUL_3_KORAIL_wagon;
    5:sw_SEOUL_3_KORAIL_wagon_panto;
    6:sw_SEOUL_3_KORAIL_wagon;
    7:sw_SEOUL_3_KORAIL_wagon_panto;
    8:sw_SEOUL_3_KORAIL_wagon;
    9:sw_SEOUL_3_KORAIL_engineT;
    sw_SEOUL_3_KORAIL_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_korail_2_flipped, vehicle_is_flipped){
    0: sw_SEOUL_3_korail_2_r;
    sw_SEOUL_3_korail_2;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_3_korail_2_reversed, vehicle_is_reversed){
    0: sw_SEOUL_3_korail_2;
    sw_SEOUL_3_korail_2_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_3_KORAIL_COMBINED, cargo_subtype) {
    1..2: return sw_SEOUL_3_korail_1_reversed;
    3..4: return sw_SEOUL_3_korail_2_reversed;
    return sw_SEOUL_3_korail_1;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_3_korail, extra_callback_info1) {
    1..9: SEOUL_3_korail;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_korail_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/MITSUBISHIGTOKstart.wav");
    return CB_RESULT_NO_SOUND;
}