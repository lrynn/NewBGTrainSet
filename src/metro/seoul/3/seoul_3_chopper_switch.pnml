/*------------------------------------------------------------------------------
    SEOUL - LINE 3
    Switches - CHOPPER
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_WIDE, position_in_vehid_chain % 10) {
    1:set_SEOUL_3_CHOPPER_WIDE_wagon;
    2:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    3:set_SEOUL_3_CHOPPER_WIDE_wagon;
    4:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    5:set_SEOUL_3_CHOPPER_WIDE_wagon;
    6:set_SEOUL_3_CHOPPER_WIDE_wagon;
    7:set_SEOUL_3_CHOPPER_WIDE_wagon;
    8:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    9:set_SEOUL_3_CHOPPER_WIDE_engineT;
    set_SEOUL_3_CHOPPER_WIDE_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_WIDE_r, position_in_vehid_chain % 10) {
    1:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    2:set_SEOUL_3_CHOPPER_WIDE_wagon;
    3:set_SEOUL_3_CHOPPER_WIDE_wagon;
    4:set_SEOUL_3_CHOPPER_WIDE_wagon;
    5:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    6:set_SEOUL_3_CHOPPER_WIDE_wagon;
    7:set_SEOUL_3_CHOPPER_WIDE_wagon_panto;
    8:set_SEOUL_3_CHOPPER_WIDE_wagon;
    9:set_SEOUL_3_CHOPPER_WIDE_engineT;
    set_SEOUL_3_CHOPPER_WIDE_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_WIDE_flipped, vehicle_is_flipped){
    0: sw_SEOUL_3_CHOPPER_WIDE_r;
    sw_SEOUL_3_CHOPPER_WIDE;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_3_CHOPPER_WIDE_reversed, vehicle_is_reversed){
    0: sw_SEOUL_3_CHOPPER_WIDE;
    sw_SEOUL_3_CHOPPER_WIDE_flipped;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_MODIFIED, position_in_vehid_chain % 10) {
    1:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    2:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    3:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    4:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    5:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    6:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    7:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    8:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    9:set_SEOUL_3_CHOPPER_MODIFIED_engineT;
    set_SEOUL_3_CHOPPER_MODIFIED_engineH; //default
}
switch (FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_MODIFIED_r, position_in_vehid_chain % 10) {
    1:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    2:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    3:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    4:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    5:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    6:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    7:set_SEOUL_3_CHOPPER_MODIFIED_wagon_panto;
    8:set_SEOUL_3_CHOPPER_MODIFIED_wagon;
    9:set_SEOUL_3_CHOPPER_MODIFIED_engineT;
    set_SEOUL_3_CHOPPER_MODIFIED_engineH; //default
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_CHOPPER_MODIFIED_flipped, vehicle_is_flipped){
    0: sw_SEOUL_3_CHOPPER_MODIFIED_r;
    sw_SEOUL_3_CHOPPER_MODIFIED;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_3_CHOPPER_MODIFIED_reversed, vehicle_is_reversed){
    0: sw_SEOUL_3_CHOPPER_MODIFIED;
    sw_SEOUL_3_CHOPPER_MODIFIED_flipped;
}


// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_3_CHOPPER_WIDE, extra_callback_info1) {
    1..9: SEOUL_3_chopper_wide;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_3_CHOPPER_MODIFIED, extra_callback_info1) {
    1..9: SEOUL_3_chopper_modified;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_3_chopper_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/GECCHOPPERstart.wav");
    return CB_RESULT_NO_SOUND;
}