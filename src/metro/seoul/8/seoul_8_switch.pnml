/*------------------------------------------------------------------------------
    SEOUL - LINE 8 Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
switch(FEAT_TRAINS, SELF, sw_SEOUL_8_cargo_subtype_text, cargo_subtype) {
    1: return string(STR_REFIT_METRO_LINE_8_1_NAME);
    2: return string(STR_REFIT_METRO_LINE_8_2_NAME);
    3: return string(STR_REFIT_METRO_LINE_8_3_NAME);
    return string(STR_REFIT_METRO_LINE_8_1_NAME);
}

// Train Composition
switch (FEAT_TRAINS, SELF, sw_SEOUL_8, position_in_vehid_chain % 6) {
    1:set_SEOUL_8_1_wagon_panto;
    2:set_SEOUL_8_1_wagon;
    3:set_SEOUL_8_1_wagon_panto;
    4:set_SEOUL_8_1_wagon;
    5:set_SEOUL_8_1_engineT;
    set_SEOUL_8_1_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_8_r, position_in_vehid_chain % 6) {
    1:set_SEOUL_8_1_wagon;
    2:set_SEOUL_8_1_wagon_panto;
    3:set_SEOUL_8_1_wagon;
    4:set_SEOUL_8_1_wagon_panto;
    5:set_SEOUL_8_1_engineT;
    set_SEOUL_8_1_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_8_flipped, vehicle_is_flipped){
    0: sw_SEOUL_8_r;
    sw_SEOUL_8;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_8_reversed, vehicle_is_reversed){
    0: sw_SEOUL_8;
    sw_SEOUL_8_flipped;
}

// Livery for 3RD Edition
switch (FEAT_TRAINS, SELF, sw_SEOUL_8_3, position_in_vehid_chain % 6) {
    1:set_SEOUL_8_3_wagon_panto_A;
    2:set_SEOUL_8_3_wagon_B;
    3:set_SEOUL_8_3_wagon_panto_A;
    4:set_SEOUL_8_3_wagon_B;
    5:set_SEOUL_8_3_engineT;
    set_SEOUL_8_3_engineH;
    }
switch (FEAT_TRAINS, SELF, sw_SEOUL_8_3_r, position_in_vehid_chain % 6) {
    1:set_SEOUL_8_3_wagon_A;
    2:set_SEOUL_8_3_wagon_panto_B;
    3:set_SEOUL_8_3_wagon_A;
    4:set_SEOUL_8_3_wagon_panto_B;
    5:set_SEOUL_8_3_engineT;
    set_SEOUL_8_3_engineH;
    }
switch(FEAT_TRAINS, SELF, sw_SEOUL_8_3_flipped, vehicle_is_flipped){
    0: sw_SEOUL_8_3_r;
    sw_SEOUL_8_3;
}
switch(FEAT_TRAINS, PARENT, sw_SEOUL_8_3_reversed, vehicle_is_reversed){
    0: sw_SEOUL_8_3;
    sw_SEOUL_8_3_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_SEOUL_8, extra_callback_info1) {
    1..5: SEOUL_8;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

switch (FEAT_TRAINS, SELF, sw_SEOUL_8_COMBINED_reversed, cargo_subtype) {
    1..2: return sw_SEOUL_8_reversed;
    3: return sw_SEOUL_8_3_reversed;
    return sw_SEOUL_8_reversed;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_SEOUL_8_sound_by_supplier, cargo_subtype) {
    1: return sound("sounds/ALSTOMGTOstart.wav");
    2: return sound("sounds/TOSHIBAIGBTKStart.wav");
    3: return sound("sounds/TOSHIBAIGBTPMSMstart.wav");
    return sound("sounds/ALSTOMGTOstart.wav");
}
switch(FEAT_TRAINS, SELF, sw_SEOUL_8_sound, extra_callback_info1) {
    SOUND_EVENT_START: sw_SEOUL_8_sound_by_supplier;
    return CB_RESULT_NO_SOUND;
}