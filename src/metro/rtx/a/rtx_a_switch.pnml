/*------------------------------------------------------------------------------
  RTX-A Switches
------------------------------------------------------------------------------*/

// Cargo Subtypes
// None

// Train Composition
switch (FEAT_TRAINS, SELF, sw_RTX_A, position_in_vehid_chain % 8) {
    1:set_RTX_A_wagon;
    2:set_RTX_A_wagon_panto2;
    3:set_RTX_A_wagon;
    4:set_RTX_A_wagon;
    5:set_RTX_A_wagon_panto1;
    6:set_RTX_A_wagon;
    7:set_RTX_A_engineT;
    set_RTX_A_engineH;
}
switch (FEAT_TRAINS, SELF, sw_RTX_A_r, position_in_vehid_chain % 8) {
    1:set_RTX_A_wagon;
    2:set_RTX_A_wagon_panto2;
    3:set_RTX_A_wagon;
    4:set_RTX_A_wagon;
    5:set_RTX_A_wagon_panto1;
    6:set_RTX_A_wagon;
    7:set_RTX_A_engineT;
    set_RTX_A_engineH;
}
switch(FEAT_TRAINS, SELF, sw_RTX_A_flipped, vehicle_is_flipped){
    0: sw_RTX_A_r;
    sw_RTX_A;
}
switch(FEAT_TRAINS, PARENT, sw_RTX_A_reversed, vehicle_is_reversed){
    0: sw_RTX_A;
    sw_RTX_A_flipped;
}

// to set length of composition
switch (FEAT_TRAINS, SELF, sw_articulated_RTX_A, extra_callback_info1) {
    1..7: RTX_A;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// Sounds
switch(FEAT_TRAINS, SELF, sw_RTX_A_sound, extra_callback_info1) {
    SOUND_EVENT_START: sound("sounds/TOSHIBASicStart.wav");
    SOUND_EVENT_LOAD_UNLOAD: sound("sounds/BTC_DOOR_CLOSE.wav");
    return CB_RESULT_NO_SOUND;
}